# Variáveis de docker-compose.prod.yml. No Coolify, cadastre na aba
# "Environment Variables" do recurso; fora dele, copie para .env.production
# (nunca versionado).
#
# Geração dos segredos:
#   senha/token hex : openssl rand -hex 32
#   chave 32 bytes  : openssl rand -base64 32
# Use hex nas senhas de banco: elas entram em URLs de conexão.

# Domínios públicos (com https://, sem barra final)
APP_URL=https://app.exemplo.com.br
API_URL=https://api.exemplo.com.br
# lax quando APP e API compartilham o domínio registrável; none se não.
COOKIE_SAME_SITE=lax

# Postgres: superusuário e uma senha por serviço. Lidas só na criação do
# volume; trocar depois exige ALTER ROLE no banco.
POSTGRES_PASSWORD=
BFF_DB_PASSWORD=
AI_DB_PASSWORD=
SCHEDULING_DB_PASSWORD=
EVOLUTION_DB_PASSWORD=

# Segredos compartilhados entre serviços
INTERNAL_SERVICE_TOKEN=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# BFF
JWT_SECRET=
# "<keyId>:<openssl rand -base64 32>", separadas por vírgula
WHATSAPP_CREDENTIAL_KEYS=v1:
WHATSAPP_CREDENTIAL_ACTIVE_KEY_ID=v1
RESEND_API_KEY=
EMAIL_FROM=Avenly <nao-responda@avenly.com.br>

# IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Material próprio da IA, mesmo formato e chave diferente da do BFF
CHANNEL_CREDENTIAL_KEYS=v1:
CHANNEL_CREDENTIAL_ACTIVE_KEY_ID=v1
PLATFORM_WHATSAPP_INSTANCE_ID=
PLATFORM_WHATSAPP_CREDENTIAL=
PLATFORM_WHATSAPP_NUMBER=

# Agenda
# openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=
MINHA_AGENDA_OAUTH_CLIENT_CREDENTIAL=

# Frontend: dados legais embutidos no build das páginas estáticas
AVENLY_LEGAL_NAME=
AVENLY_TRADE_NAME=
AVENLY_CNPJ=
AVENLY_LEGAL_ADDRESS=
AVENLY_SUPPORT_EMAIL=
AVENLY_PRIVACY_EMAIL=
AVENLY_PRIVACY_OFFICER=
AVENLY_AI_PROVIDER=
AVENLY_HOSTING_PROVIDER=
AVENLY_ANALYTICS_PROVIDERS=
AVENLY_RETENTION_PERIOD=
AVENLY_APPLICABLE_FORUM=
AVENLY_LEGAL_REVIEW_APPROVED=false
AVENLY_LEGAL_INDEXABLE=false
