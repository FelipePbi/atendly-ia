# Dependencies
node_modules/

# Build outputs
dist/
.next/
build/
coverage/
coverage.out
coverage.html

# Environment and secrets
.env
.env.*
!.env.example

# Logs and local runtime files
logs/
*.log
*.tmp

# OS/editor metadata
.DS_Store
Thumbs.db
*.Zone.Identifier

# Legacy source repositories kept in the workspace during migration.
# The monorepo source lives under apps/*.
/api/
/evolution-go/
/health-worker/
/whatsapp-ai-inbox-frontend/

# Generated during BFF build.
/apps/bff/src/generated/

# Generated during AI Orchestrator build.
/apps/ai-orchestrator/src/generated/

# Large prompt kit copied from earlier planning material; keep outside the initial monorepo commit.
/docs/codex_persona_ui_kit/

# Graphify keeps graph/map files in Git. Cache and machine-local state stay local.
/graphify-out/cache/
/graphify-out/cost.json
/graphify-out/.graphify_analysis.json
/graphify-out/.graphify_root
/.playwright-mcp/

# Evolution Go Dockerfile expects this bundled manager asset.
!/apps/evolution-go/manager/
!/apps/evolution-go/manager/dist/
!/apps/evolution-go/manager/dist/**

# Obsidian vault (docs/product-vault): version the portable settings, ignore machine state.
docs/product-vault/.obsidian/workspace.json
docs/product-vault/.obsidian/workspace-mobile.json
docs/product-vault/.obsidian/cache
docs/product-vault/.obsidian/graph.json
docs/product-vault/.obsidian/hotkeys.json
docs/product-vault/.obsidian/plugins/
docs/product-vault/.obsidian/themes/
docs/product-vault/.trash/
