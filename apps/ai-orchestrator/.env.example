# Ambiente de execucao do AI Orchestrator
NODE_ENV=development

# Porta HTTP do servidor
AI_ORCHESTRATOR_PORT=3000
PORT=3000

# Banco do AI Orchestrator
DATABASE_URL=postgresql://app:app@ai-orchestrator-postgres:5432/ai_orchestrator?sslmode=disable
# Checkpoints LangGraph usam schema PostgreSQL dedicado `langgraph`. Lidas so
# pelo container Postgres do docker-compose local, fora do schema validado de
# config/env.ts.
# AI_ORCHESTRATOR_POSTGRES_USER=app
# AI_ORCHESTRATOR_POSTGRES_PASSWORD=app
# AI_ORCHESTRATOR_POSTGRES_DB=ai_orchestrator

# Canal WhatsApp via Evolution Go
EVOLUTION_WEBHOOK_TOKEN=troque-este-token
EVOLUTION_BASE_URL=http://evolution-go:8080
EVOLUTION_API_KEY=troque-esta-chave-global
EVOLUTION_SEND_TEXT_PATH=/send/text
# Download sob demanda de midia, com a credencial da instancia (Goal013)
EVOLUTION_DOWNLOAD_MEDIA_PATH=/message/downloadmedia
EVOLUTION_DOWNLOAD_MEDIA_TIMEOUT_MS=60000
EVOLUTION_BOT_ENABLED=true
EVOLUTION_ALLOW_SELF_CHAT=false
HUMAN_HANDOFF_PAUSE_MINUTES=120
# Teto do corpo aceito pela rota do webhook: midia inline chega em base64
# dentro do JSON (32 MiB).
EVOLUTION_WEBHOOK_BODY_LIMIT_BYTES=33554432

# Transcricao de audio (mesma conta OpenAI; nenhum teste chama a API real)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE=pt
OPENAI_TRANSCRIPTION_TIMEOUT_MS=120000
# Acima destes tetos o audio e SKIPPED com motivo, sem transcricao parcial
AUDIO_TRANSCRIPTION_MAX_BYTES=26214400
AUDIO_TRANSCRIPTION_MAX_SECONDS=600

# Buffer/debounce da IA antes de responder mensagens recebidas
AI_DEBOUNCE_MIN_SECONDS=8
AI_DEBOUNCE_MAX_SECONDS=35
AI_DEBOUNCE_MAX_WAIT_SECONDS=60
AI_AMBIGUOUS_WAIT_SECONDS=120
AI_AMBIGUOUS_MAX_WAIT_SECONDS=300
# Sessao de conversa: inatividade do contato que a expira (~24 h).
AI_SESSION_INACTIVITY_SECONDS=86400

# Inbox duravel: loop de processamento no proprio processo da IA.
INBOX_WORKER_ENABLED=true
INBOX_POLL_INTERVAL_MS=1000
INBOX_LEASE_SECONDS=120
# Heartbeat do lease durante a execucao de um lote longo.
INBOX_LEASE_HEARTBEAT_SECONDS=30
INBOX_MAX_ATTEMPTS=5
INBOX_RETRY_BASE_SECONDS=15
INBOX_RETRY_MAX_SECONDS=900
INBOX_MAX_CONCURRENT_CONVERSATIONS=4
INBOX_GROUP_BATCH_LIMIT=20
# Retencao TECNICA do inbox duravel (Goal023). `ProcessedEvent` e rastro de
# execucao do transporte, nao conteudo de conversa: o prazo nao e escolha da
# profissional e nao vem do BFF. Encurtar abaixo da janela de reentrega do
# provider reabre o reprocessamento do mesmo evento — o motivo esta escrito
# junto da constante, em src/modules/retention/inbox-retention.ts.
INBOX_RETENTION_DAYS=180
# Timeout do envio ao transporte; sem ele a saida fica pendurada em PENDING.
EVOLUTION_SEND_TIMEOUT_MS=15000

# Entrega das intencoes de envio (Goal021): loop no proprio processo da IA,
# sem broker novo. Ligada porque e o proprio caminho de lembrete, nao uma
# varredura destrutiva opcional.
NOTIFICATION_DELIVERY_ENABLED=true
NOTIFICATION_DELIVERY_POLL_INTERVAL_MS=15000
NOTIFICATION_DELIVERY_BATCH_LIMIT=50
NOTIFICATION_DELIVERY_TENANT_LIMIT=10
NOTIFICATION_DELIVERY_LEASE_SECONDS=120

# Retorno de clientes (D-206): envia as rodadas aprovadas pela profissional,
# no ritmo delas, e marca as respostas dos convites. Ligado porque so sai
# mensagem de rodada aprovada; desligue em base local com clientes reais.
RETURN_DELIVERY_ENABLED=true
RETURN_DELIVERY_POLL_INTERVAL_MS=60000
RETURN_DELIVERY_LEASE_SECONDS=120
RETURN_DELIVERY_TENANT_LIMIT=50

# Intervalo tecnico opcional entre servicos no mesmo agendamento
AI_BUFFER_BETWEEN_SERVICES_MINUTES=0

# Versao registrada nos logs de decisao da IA
AI_PROMPT_VERSION=scheduling_v1.0.0

# Banco do Evolution Go. Lidas so pelo container Evolution Go do
# docker-compose local, fora do schema validado de config/env.ts.
# EVOGO_POSTGRES_USER=postgres
# EVOGO_POSTGRES_PASSWORD=postgres
# EVOGO_AUTH_DB=evogo_auth
# EVOGO_USERS_DB=evogo_users
# EVOGO_DATABASE_SAVE_MESSAGES=false
# EVOGO_WADEBUG=INFO
# EVOGO_LOGTYPE=console

# Chave da OpenAI
OPENAI_API_KEY=

# Modelo usado pelo atendente
OPENAI_MODEL=gpt-5.4-mini

# Modelo de embedding RAG. O schema atual usa vector(1536).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Limite de tokens da resposta da IA
OPENAI_MAX_OUTPUT_TOKENS=600

# Retrieval tenant-scoped de conhecimento do negocio
KNOWLEDGE_SEARCH_LIMIT=4
KNOWLEDGE_SEARCH_MIN_SCORE=0.65

# Memoria do cliente: idade a partir da qual o item entra no prompt marcado
# como antigo (menor peso) e teto de itens carregados por pessoa.
CUSTOMER_MEMORY_STALE_DAYS=180
CUSTOMER_MEMORY_PROMPT_LIMIT=12

# Scheduling Service e autenticacao service-to-service
SCHEDULING_SERVICE_BASE_URL=http://localhost:3003

# Credenciais internas aceitas, por uso. Vazias, sao derivadas de
# INTERNAL_SERVICE_TOKEN por HMAC, com o mesmo contrato do lado do BFF.
INTERNAL_SERVICE_TOKEN=
INTERNAL_PROVISIONING_TOKEN=
INTERNAL_COMMAND_TOKEN=
# Credencial que a IA apresenta ao scheduling-service.
SCHEDULING_SERVICE_COMMAND_TOKEN=

# Cifra da projecao da credencial de instancia recebida do BFF. Mesmo formato e
# mesma politica de rotacao das chaves do BFF, com material proprio.
CHANNEL_CREDENTIAL_KEYS=v1:
CHANNEL_CREDENTIAL_ACTIVE_KEY_ID=v1

# Numero oficial da Avenly usado no teste real da IA. E configuracao do
# servico, nao vinculo de negocio: nao vira linha de ChannelConnection e nao
# aparece em nenhuma listagem de conexoes de tenant. Sem as tres chaves abaixo
# o teste real e recusado com PLATFORM_NUMBER_NOT_CONFIGURED.
# Valores de exemplo; o segredo real nunca entra neste arquivo.
PLATFORM_WHATSAPP_INSTANCE_ID=atendly-platform
PLATFORM_WHATSAPP_CREDENTIAL=troque-esta-credencial-da-plataforma
PLATFORM_WHATSAPP_NUMBER=5500000000000

# Validacao local com WhatsApp real: so estes numeros (digitos com DDI,
# separados por virgula) recebem resposta da IA. Vazio em producao.
AI_REPLY_ONLY_PHONES=

# Trava de transporte para teste local: true bloqueia todo envio ao WhatsApp
# (IA, profissional, lembrete). A tentativa fica FAILED com motivo. Sempre
# false em producao.
WHATSAPP_OUTBOUND_DISABLED=false
