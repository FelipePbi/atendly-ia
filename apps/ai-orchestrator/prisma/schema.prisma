generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelProvider {
  EVOLUTION_GO
}

enum ChannelConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  CUSTOMER
  AI
  OWNER
}

enum ConversationStatus {
  ACTIVE
  HUMAN_HANDOFF
  CLOSED
}

enum AiRunStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum ToolCallStatus {
  STARTED
  SUCCEEDED
  FAILED
}

/// Estado de execucao do evento recebido na inbox duravel.
///
/// LEGACY marca as linhas gravadas antes do Goal004, quando ProcessedEvent
/// provava recebimento e nao conclusao: elas nao sao reprocessadas.
enum InboundEventStatus {
  RECEIVED
  PROCESSING
  DONE
  FAILED
  IGNORED
  LEGACY
}

/// Estado de entrega de uma saida (outbox). UNKNOWN e o unico estado que a
/// plataforma nao pode afirmar: so muda por reconciliacao.
enum MessageDeliveryState {
  PENDING
  SENT
  FAILED
  UNKNOWN
}

enum HandoffStatus {
  OPEN
  RESOLVED
}

/// As tres organizacoes da inbox. E atributo da sessao, nao do contato: um
/// contato pode abrir uma sessao comercial hoje e uma pessoal em outro mes.
enum SessionCategory {
  COMMERCIAL
  UNCLASSIFIED
  PERSONAL
}

/// De onde veio a categoria vigente da sessao. MANUAL e decisao da
/// profissional e prevalece sobre qualquer sugestao automatica.
enum CategorySource {
  AUTOMATIC
  MANUAL
}

/// Por onde o atendimento humano assumiu a sessao. Registrado para o painel
/// explicar o estado, nunca para mudar a decisao.
enum HumanControlSource {
  WHATSAPP
  AVENLY
  BACKFILL
}

/// Estilo de conversa do negocio: influencia registro, emoji e informalidade,
/// nunca decisao operacional. Os tres valores do produto sao PROFESSIONAL,
/// BALANCED (default) e CASUAL. Os dois valores antigos continuam declarados
/// porque `ALTER TYPE ... ADD VALUE` nao remove valor do tipo do banco: eles
/// seguem legiveis e aceitos na entrada como alias normalizado ate o Goal024,
/// enquanto a saida ja usa so o vocabulario novo.
enum AiTone {
  PROFESSIONAL
  BALANCED
  CASUAL
  /// Legado, alias de PROFESSIONAL. Nenhuma linha nasce aqui.
  PROFESSIONAL_OBJECTIVE
  /// Legado, alias de BALANCED. Nenhuma linha nasce aqui.
  LIGHT_CLOSE
}

enum KnowledgeDocumentType {
  FAQ
  GUIDANCE
  CARE
  PROCEDURE
  BUSINESS_INFO
  TEXT_POLICY
}

enum KnowledgeDocumentStatus {
  ACTIVE
  INACTIVE
}

/// De onde vem uma linha de CustomerMemory. CUSTOMER_STATED e PROFESSIONAL sao
/// afirmacao humana; AI_INFERRED e a unica que carrega `confidence`.
enum CustomerMemoryOrigin {
  CUSTOMER_STATED
  AI_INFERRED
  PROFESSIONAL
}

/// Proposito de um AiRun. TURN e o turno normal de conversa (default, unico
/// valor que o binario anterior ao Goal012 escreve). SUGGESTION e SUMMARY sao
/// execucoes sem efeito sobre a conversa, so para auditoria.
enum AiRunKind {
  TURN
  SUGGESTION
  SUMMARY
}

/// Tipo de conteudo de uma `Message`. `TEXT` e o default: toda linha gravada
/// antes do Goal013 e todo turno de texto continuam TEXT sem backfill. Mídia
/// vem com uma linha em `MessageAttachment` (Goal013/WU-02).
enum MessageKind {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
  STICKER
  UNKNOWN
}

/// Kind da mídia anexada. Sem TEXT nem UNKNOWN: as duas nunca geram
/// `MessageAttachment`.
enum MessageAttachmentKind {
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
  STICKER
}

/// Estado da transcrição de uma mídia com áudio (Goal013/WU-03). PENDING e
/// SKIPPED não têm o mesmo significado: SKIPPED é decisão explícita (mídia
/// grande demais, tipo sem áudio), PENDING é fila.
enum TranscriptStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

model ChannelConnection {
  id                  String                  @id @default(cuid())
  tenantId            String
  userId              String
  provider            ChannelProvider
  externalInstanceId  String
  displayName         String?
  status              ChannelConnectionStatus @default(ACTIVE)
  metadata            Json?
  /// Projecao cifrada da credencial da instancia, entregue pelo BFF no
  /// provisionamento. Nula enquanto o vinculo nao foi reprovisionado.
  credentialCipher    String?
  credentialKeyId     String?
  credentialVersion   Int                     @default(0)
  credentialRotatedAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  contacts        Contact[]
  conversations   Conversation[]
  messages        Message[]
  processedEvents ProcessedEvent[]
  aiRuns          AiRun[]
  handoffs        Handoff[]

  @@unique([provider, externalInstanceId])
  @@unique([tenantId, provider])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([credentialVersion])
}

model Conversation {
  id                 String             @id @default(cuid())
  tenantId           String
  channelId          String
  externalContactId  String
  customerName       String?
  currentIntent      String?
  state              Json?
  status             ConversationStatus @default(ACTIVE)
  humanHandoff       Boolean            @default(false)
  handoffPausedUntil DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  /// Vinculo com o Contato do canal. Opcional por compatibilidade: binario
  /// anterior ignora a coluna e o backfill preenche sem apagar nada.
  contactId String?

  /// Ate quando o conteudo desta conversa ja foi purgado (Goal023/WU-02).
  ///
  /// Nulo enquanto nada expirou — e nulo nunca e fabricado por default de
  /// coluna. So avanca: a purga nunca escreve um instante anterior ao ja
  /// gravado, porque o que foi apagado nao volta. E o que a interface le para
  /// dizer que mensagens antigas expiraram, em vez de inferir expiracao pela
  /// ausencia de mensagem.
  contentExpiredThrough DateTime?

  /// Ate quando a profissional ja viu a conversa no app (D-195). Mensagem do
  /// cliente depois disto e "nao lida", a nao ser que a profissional tenha
  /// respondido depois dela (pelo app ou pelo proprio WhatsApp). Nulo: nunca
  /// aberta, entao toda mensagem do cliente conta. Gravada so por SQL cru, para
  /// nao mexer em `updatedAt`, que ordena a lista.
  ownerReadAt DateTime?

  channel  ChannelConnection     @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  contact  Contact?              @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: SetNull, map: "Conversation_contact_fkey")
  messages Message[]
  aiRuns   AiRun[]
  handoffs Handoff[]
  sessions ConversationSession[]

  @@unique([tenantId, channelId, externalContactId])
  @@unique([tenantId, channelId, id])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, contactId])
}

/// Contato do canal.
///
/// Guarda o que e do contato e nao da conversa: identidade externa, perfil
/// predominante, `ignored` (regra absoluta, prevalece sobre a sessao) e a pausa
/// explicita da IA — `/bot off` e `/ia_pause` nao podem ser desfeitos por
/// expiracao de sessao nem por relogio.
///
/// Nao existe identidade de pessoa, nota, tag nem memoria estruturada aqui:
/// isso e dos Goals 006 e 012.
model Contact {
  id                String  @id @default(cuid())
  tenantId          String
  channelId         String
  externalContactId String
  displayName       String?

  /// Contato ignorado: a IA nunca atende, em nenhuma sessao. Guarda quando e
  /// por quem foi marcado, porque rollback nao pode desfazer a decisao.
  ignored       Boolean   @default(false)
  ignoredAt     DateTime?
  ignoredBy     String?
  ignoredSource String?

  /// Pausa explicita da IA para este contato (`/bot off`, `/ia_pause`). Vive
  /// no contato, e nao na sessao, para que a expiracao de ~24 h nao devolva a
  /// conversa a IA sem alguem ter pedido.
  aiPaused       Boolean   @default(false)
  aiPausedAt     DateTime?
  aiPausedReason String?

  /// Override manual de categoria. Prevalece sobre qualquer classificacao
  /// automatica e atravessa a troca de sessao.
  categoryOverride   SessionCategory?
  categoryOverrideAt DateTime?
  categoryOverrideBy String?

  /// Pessoa do Scheduling que escreve por este numero: sempre um candidato do
  /// telefone, preenchida quando um agendamento e confirmado. Referencia por ID
  /// e tenant: nenhuma FK atravessa bancos. Quando o responsavel agenda para um
  /// dependente, o vinculo fica no responsavel; o dependente vai em
  /// `lastScheduledCustomerId`.
  customerId       String?
  customerLinkedAt DateTime?

  /// Ultima pessoa agendada por este numero, que pode ser um dependente (mae
  /// que agenda para o filho). Mesma referencia por ID e tenant, sem FK. Serve
  /// a pessoa provavel do proximo agendamento e ao resumo do dependente.
  lastScheduledCustomerId String?
  lastScheduledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  /// Canal a que o contato pertence. A FK existe no banco desde a migration
  /// do Goal005 (`Contact_channel_fkey`); declara-la aqui e o que mantem
  /// `schema.prisma` e o historico de migrations dizendo a mesma coisa.
  channel ChannelConnection @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade, map: "Contact_channel_fkey")

  conversations Conversation[]
  sessions      ConversationSession[]

  @@unique([tenantId, channelId, externalContactId])
  @@unique([tenantId, id])
  @@index([tenantId, ignored])
  @@index([tenantId, customerId])
}

/// Sessao de conversa.
///
/// Janela de aproximadamente 24 h sem interacao do contato. A categoria
/// vigente, a sugestao automatica com proveniencia e o estado de atendimento
/// humano sao atributos dela; expirar abre uma sessao nova, que pode reavaliar
/// a intencao — nunca para contato ignorado.
model ConversationSession {
  id             String @id @default(cuid())
  tenantId       String
  channelId      String
  conversationId String
  contactId      String

  startedAt            DateTime  @default(now())
  /// Ultima interacao do contato. E ela, e nao a resposta da IA, que renova a
  /// sessao: cliente que sumiu deixa a sessao expirar.
  lastContactMessageAt DateTime?
  expiresAt            DateTime
  endedAt              DateTime?
  endedReason          String?

  category          SessionCategory @default(UNCLASSIFIED)
  categorySource    CategorySource  @default(AUTOMATIC)
  categoryUpdatedAt DateTime?
  categoryUpdatedBy String?
  /// Decisao manual "so esta conversa" (Goal115). Vale apenas nesta sessao e
  /// prevalece sobre `Contact.categoryOverride`; toda sessao nova nasce nula,
  /// por isso a conversa seguinte volta a regra do contato e a classificacao.
  categoryOverride  SessionCategory?

  /// Sugestao do agente, com proveniencia. Nunca vira override manual.
  suggestedCategory    SessionCategory?
  suggestionProvenance String?
  suggestedAt          DateTime?

  humanHandling       Boolean             @default(false)
  humanHandlingSince  DateTime?
  humanHandlingSource HumanControlSource?
  humanHandlingBy     String?

  /// `Retomar IA` marca aqui: o proximo turno reavalia o contexto a partir
  /// deste instante em vez de continuar do ponto anterior.
  contextResetAt DateTime?

  /// Versao de entrada da sessao. Incrementa a cada mensagem do contato e e
  /// comparada antes de executar tool com efeito e antes de enviar.
  inboundVersion Int @default(0)

  /// Marca de pendencia do backfill. Preenchida so quando o estoque legado era
  /// ambiguo; nao e usada para decidir nada em runtime.
  backfillNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  conversation Conversation @relation(fields: [tenantId, channelId, conversationId], references: [tenantId, channelId, id], onDelete: Cascade, map: "ConversationSession_conversation_fkey")
  contact      Contact      @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade, map: "ConversationSession_contact_fkey")

  /// DIVERGENCIA DE SCHEMA CONHECIDA: existe tambem um indice unico **parcial**
  /// `ConversationSession_one_open_per_conversation` sobre
  /// `("tenantId","conversationId") WHERE "endedAt" IS NULL`, criado em SQL na
  /// migration `20260908171000_goal005_single_open_session`. O Prisma nao
  /// modela indice parcial, entao ele nao aparece aqui; `prisma migrate diff`
  /// vai relatar essa diferenca e ela e intencional.
  humanTakeovers HumanTakeover[]

  @@unique([tenantId, id])
  @@index([tenantId, conversationId, startedAt])
  @@index([tenantId, conversationId, endedAt])
  @@index([tenantId, category, humanHandling])
}

/// Registro durável de cada passagem de IA para humano (Goal074).
///
/// `assumeHumanControl` grava uma linha aqui só na transição real (a sessão
/// não estava em atendimento humano) e só para `WHATSAPP`/`AVENLY`:
/// `BACKFILL` reconstrói estado passado, não uma tomada que aconteceu agora.
/// `releaseToAi` nunca apaga linha — o registro é histórico, não espelho do
/// estado corrente da sessão.
model HumanTakeover {
  id             String             @id @default(cuid())
  tenantId       String
  sessionId      String
  conversationId String
  source         HumanControlSource
  actor          String?
  takenAt        DateTime           @default(now())
  createdAt      DateTime           @default(now())

  session ConversationSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade, map: "HumanTakeover_session_fkey")

  @@index([tenantId, takenAt])
  @@index([tenantId, conversationId, takenAt])
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  channelId         String
  conversationId    String
  externalMessageId String?
  direction         MessageDirection
  source            MessageSource?
  role              String
  body              String
  /// Tipo de conteudo (Goal013). Default TEXT: nao muda nada do estoque
  /// anterior a este Goal.
  kind              MessageKind      @default(TEXT)
  rawPayload        Json?
  createdAt         DateTime         @default(now())

  /// Operation-id estavel da tentativa de saida, gerado antes de chamar o
  /// transporte. Sobrevive a retry e e o que o recibo do Go reconcilia.
  correlationId     String?
  /// Nulo em INBOUND e no estoque anterior ao Goal004. O backfill marca
  /// OUTBOUND legado como UNKNOWN: nunca SENT presumido.
  deliveryState     MessageDeliveryState?
  deliveryDetail    String?
  deliveryAttempts  Int                   @default(0)
  deliveryUpdatedAt DateTime?
  /// Resposta da IA despachada em varias mensagens curtas (2026-10-11): quantas
  /// partes ja sairam. A linha continua uma so (texto completo) e so vira SENT
  /// depois da ultima parte; o retry retoma daqui sem reenviar parte enviada.
  deliveryPartsSent Int                   @default(0)

  channel      ChannelConnection   @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [tenantId, channelId, conversationId], references: [tenantId, channelId, id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, channelId, externalMessageId])
  @@unique([tenantId, channelId, correlationId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, deliveryState, deliveryUpdatedAt])
}

/// Mídia de uma `Message` (Goal013/WU-02). Nunca guarda bytes nem base64: só
/// metadados e, quando o provedor hospedou o arquivo, a URL. Os bytes vivem no
/// `ProcessedEvent.rawPayload` só enquanto o evento está pendente, ou são
/// buscados sob demanda (Goal013/WU-03) pelos campos do proto no `raw` do
/// canal.
model MessageAttachment {
  id              String                @id @default(cuid())
  tenantId        String
  messageId       String
  kind            MessageAttachmentKind
  mimetype        String?
  fileName        String?
  sizeBytes       Int?
  durationSeconds Int?
  mediaUrl        String?
  tooLarge        Boolean               @default(false)

  /// Preenchidos pelo Goal013/WU-03. Nascem nulos aqui: esta Work Unit so
  /// cria a linha, nao transcreve.
  transcript         String?
  transcriptStatus   TranscriptStatus?
  transcriptError    String?
  transcriptProvider String?
  transcriptModel    String?
  transcribedAt      DateTime?
  skipReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message Message @relation(fields: [tenantId, messageId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, messageId])
  /// Varredura por estado de transcrição dentro do tenant: fila pendente,
  /// retomada de falha e auditoria do que foi pulado por política
  /// (Goal013).
  @@index([tenantId, transcriptStatus])
}

/// Inbox duravel do transporte. A linha e gravada antes do ACK; o dedupe
/// (tenantId, provider, eventKey) continua valendo, agora acompanhado do
/// estado de execucao, do lease e do resultado.
model ProcessedEvent {
  id         String          @id @default(cuid())
  tenantId   String
  channelId  String
  provider   ChannelProvider
  eventKey   String
  messageId  String
  rawPayload Json?
  receivedAt DateTime        @default(now())

  /// Tipo tecnico do evento (Message, Receipt, Presence, ...). Determina se o
  /// evento vira trabalho de conversa, reconciliacao de entrega ou registro.
  eventType            String?
  /// Chave de serializacao: os eventos de uma mesma conversa executam um de
  /// cada vez; conversas distintas correm em paralelo.
  conversationKey      String?
  status               InboundEventStatus @default(RECEIVED)
  attempts             Int                @default(0)
  nextAttemptAt        DateTime?
  leaseOwner           String?
  /// Fencing: a conclusao so vale se o token continuar sendo o do claim.
  leaseToken           String?
  leaseExpiresAt       DateTime?
  /// Mensagem nova chegou enquanto a conversa executava: a resposta ainda nao
  /// enviada e reavaliada ou cancelada.
  supersedeRequestedAt DateTime?
  result               Json?
  error                String?
  completedAt          DateTime?

  channel ChannelConnection @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, provider, eventKey])
  @@index([tenantId, channelId, receivedAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([conversationKey, status, receivedAt])
}

model AiRun {
  id              String      @id @default(cuid())
  tenantId        String
  channelId       String
  conversationId  String
  provider        String
  model           String
  promptVersion   String
  inputMessageIds String[]
  status          AiRunStatus @default(STARTED)
  /// TURN e o turno de conversa normal; SUGGESTION e SUMMARY sao execucoes sem
  /// efeito sobre a conversa (Goal012), registradas so para auditoria.
  kind            AiRunKind   @default(TURN)
  outputText      String?
  error           String?
  startedAt       DateTime    @default(now())
  completedAt     DateTime?

  channel      ChannelConnection @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  conversation Conversation      @relation(fields: [tenantId, channelId, conversationId], references: [tenantId, channelId, id], onDelete: Cascade)
  toolCalls    AiToolCall[]

  @@unique([tenantId, id])
  @@index([tenantId, conversationId, startedAt])
}

model AiToolCall {
  id             String         @id @default(cuid())
  tenantId       String
  aiRunId        String
  externalCallId String?
  name           String
  arguments      Json
  result         Json?
  status         ToolCallStatus @default(STARTED)
  error          String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  aiRun AiRun @relation(fields: [tenantId, aiRunId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, aiRunId, createdAt])
}

model Handoff {
  id                String        @id @default(cuid())
  tenantId          String
  channelId         String
  conversationId    String?
  externalContactId String
  reason            String
  summary           String?
  status            HandoffStatus @default(OPEN)
  createdAt         DateTime      @default(now())
  resolvedAt        DateTime?

  channel      ChannelConnection @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [tenantId, channelId, conversationId], references: [tenantId, channelId, id], onDelete: NoAction)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, channelId, externalContactId])
}

model AiTenantConfig {
  tenantId      String   @id
  enabled       Boolean  @default(false)
  tone          AiTone   @default(BALANCED)
  promptVersion String   @default("scheduling_v1.0.0")
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model KnowledgeDocument {
  id        String                  @id @default(cuid())
  tenantId  String
  type      KnowledgeDocumentType
  /// ID da pessoa/servico do Scheduling, sem FK entre bancos (mesmo padrao de
  /// `Contact.customerId`). Nulo significa documento geral, nao ligado a um
  /// servico especifico; documento legado (anterior ao Goal012) nasce geral.
  serviceId String?
  title     String
  source    String
  version   String
  checksum  String
  status    KnowledgeDocumentStatus @default(ACTIVE)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  chunks KnowledgeChunk[]

  @@unique([tenantId, id])
  @@unique([tenantId, type, source, version])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, serviceId])
}

/// Memoria do cliente, por `(tenantId, customerId)` da pessoa do Scheduling
/// (sem FK entre bancos). Cada linha e um fato observado, nunca sobrescrito:
/// contradicao nova marca `supersededById` na linha anterior em vez de apagar,
/// e a profissional remove marcando `removedAt`/`removedBy`. `aiAllowed`
/// decide se a linha pode entrar no prompt; a inferencia e a carga no prompt
/// sao do Goal012/WU-03, nao deste modulo.
model CustomerMemory {
  id                   String               @id @default(cuid())
  tenantId             String
  customerId           String
  kind                 String
  value                String
  origin               CustomerMemoryOrigin
  aiAllowed            Boolean              @default(false)
  /// So preenchido quando `origin = AI_INFERRED`.
  confidence           Float?
  sourceConversationId String?
  sourceMessageIds     String[]             @default([])
  observedAt           DateTime             @default(now())
  lastReinforcedAt     DateTime?
  /// ID de outra linha de CustomerMemory que substitui esta (mesmo tenant e
  /// cliente). Sem FK: a substituicao e responsabilidade de quem grava.
  supersededById       String?
  removedAt            DateTime?
  removedBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@index([tenantId, customerId, removedAt])
}

model KnowledgeChunk {
  id         String                      @id @default(cuid())
  tenantId   String
  documentId String
  content    String
  metadata   Json?
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  document KnowledgeDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, documentId])
}

/// Estado da execucao do teste real (Goal019). Terminal e nao terminal sao
/// valores distintos, de proposito: uma execucao em andamento, uma pausada por
/// interferencia humana, uma que falhou e uma que teve sucesso nao podem ser o
/// mesmo valor com interpretacoes diferentes na tela.
///
/// Nao terminais: RUNNING e PAUSED_BY_HUMAN (`finishedAt` nulo).
/// Terminais: SUCCEEDED, FAILED e DISCARDED (`finishedAt` preenchido).
/// DISCARDED e a execucao pausada que a pessoa mandou reiniciar — nao e falha,
/// e nao vira falha so para caber num estado existente.
enum ActivationTestRunState {
  RUNNING
  PAUSED_BY_HUMAN
  SUCCEEDED
  FAILED
  DISCARDED
}

/// Passos do caminho feliz do vault, na ordem do vault. O aviso de conversa de
/// teste e passo separado e nao produz marco: ele avisa, nao demonstra nada.
enum ActivationTestStep {
  TEST_NOTICE
  CLIENT_ASKS_PRICE
  AI_IDENTIFIES_SERVICE
  AI_ANSWERS_PRICE
  CLIENT_ASKS_SLOT
  AI_CHECKS_AVAILABILITY
  CLIENT_ACCEPTS_SLOT
  AI_CONFIRMS_APPOINTMENT
}

/// Os seis marcos do vault. Sao os unicos valores que a tela pode mostrar como
/// progresso; nao existe marco "generico" nem marco de tempo decorrido.
enum ActivationTestMilestoneName {
  MESSAGE_SENT
  SERVICE_IDENTIFIED
  PRICE_INFORMED
  AVAILABILITY_CHECKED
  SLOT_SELECTED
  APPOINTMENT_CONFIRMED
}

/// Natureza do fato que sustenta um marco: mensagem gravada, servico lido da
/// agenda, disponibilidade consultada ou agendamento criado. Nao ha valor para
/// "tempo passou".
enum ActivationTestFactKind {
  MESSAGE
  SERVICE
  AVAILABILITY
  APPOINTMENT
}

/// Estado da remocao dos dados de teste.
///
/// Sao tres e nao dois de proposito: `PENDING` (ainda nao limpou) nao pode ser
/// lido como sucesso, e `RESIDUAL` (limpou o que sabia limpar e algo ficou)
/// nao pode ser lido como `CLEAN`. Nao existe valor para "limpeza parcial que
/// conta como completa".
enum ActivationTestCleanupState {
  PENDING
  CLEAN
  RESIDUAL
}

/// Execucao do teste real da IA (Goal019).
///
/// Entidade com dono: existe no servidor, nao na tela. Fechar o navegador nao
/// cancela nem invalida a execucao — reabrir le esta linha.
///
/// DIVERGENCIA DE SCHEMA CONHECIDA: existe tambem um indice unico **parcial**
/// `ActivationTestRun_one_live_per_tenant` sobre `("tenantId") WHERE
/// "finishedAt" IS NULL`, criado em SQL na migration
/// `20260914120000_goal019_activation_test_run`. O Prisma nao modela indice
/// parcial, entao ele nao aparece aqui e `prisma migrate diff` vai relatar a
/// diferenca; ela e intencional e e o que garante uma unica execucao viva por
/// tenant mesmo sob duas chamadas concorrentes de inicio.
model ActivationTestRun {
  id       String                 @id @default(cuid())
  tenantId String
  state    ActivationTestRunState @default(RUNNING)

  startedAt DateTime @default(now())
  /// Preenchido **apenas** em estado terminal. `finishedAt IS NULL` e a
  /// definicao de "execucao viva" usada pelo indice unico parcial.
  finishedAt DateTime?

  /// Passo em andamento e ultimo passo concluido. Progresso de operacao, nunca
  /// substituto dos marcos: marco so existe em `ActivationTestMilestone`.
  currentStep   ActivationTestStep?
  completedStep ActivationTestStep?

  /// Tentativas do passo corrente e o limite declarado no codigo
  /// (`ACTIVATION_TEST_MAX_ATTEMPTS`), copiado na criacao para que a execucao
  /// continue legivel se o limite mudar depois.
  attempts    Int @default(0)
  maxAttempts Int

  lastError   String?
  lastErrorAt DateTime?

  /// Preenchidos so quando a execucao termina em falha. `failedStep` e o passo
  /// que falhou, em vocabulario do dominio, para a tela nomear o que quebrou.
  failedStep    ActivationTestStep?
  failureCode   String?
  failureReason String?

  /// Pausa por interferencia humana: a mensagem de origem humana que pausou.
  /// Sem ela nao ha pausa — a deteccao usa o que o sistema ja sabe distinguir.
  pausedAt          DateTime?
  pausedByMessageId String?

  /// Alvo do teste: vinculo do tenant, numero do tenant e numero da plataforma
  /// que conversa com ele. Gravados na criacao porque a execucao nao pode
  /// depender de reler configuracao que pode ter mudado no meio.
  channelId      String
  /// Instancia de WhatsApp contra a qual o teste rodou, gravada na criacao.
  ///
  /// `ChannelConnection` e unica por `(tenantId, provider)`: revincular
  /// atualiza a mesma linha e troca `externalInstanceId` sem mudar o `id`.
  /// Sem esta coluna, um teste feito com um numero continuaria valendo para
  /// outro. Nula so em execucao anterior a coluna.
  channelInstanceId String?
  tenantPhone    String
  platformNumber String

  /// Servico escolhido pelo sistema e horario aceito pelo cliente simulado.
  serviceId     String?
  serviceName   String?
  slotDate      String?
  slotStartTime String?

  /// IDs do que a execucao criou, gravados **no momento da criacao**. A limpeza
  /// remove exatamente isto, nunca por busca por telefone, nome ou data.
  conversationId    String?
  contactId         String?
  createdMessageIds String[] @default([])
  appointmentId     String?
  customerId        String?

  /// Criado **por esta execucao**, nao apenas encontrado por ela.
  ///
  /// `conversationId`/`contactId` acima sao o alvo por onde a execucao
  /// conversa — a conversa de teste pode ja existir de uma execucao anterior.
  /// Os dois campos abaixo sao preenchidos so quando a linha nasceu nesta
  /// execucao, e sao os unicos que a limpeza apaga. Sem essa distincao, uma
  /// conversa preexistente com o numero da plataforma seria removida por uma
  /// execucao que nao a criou.
  createdConversationId String?
  createdContactId      String?

  /// Remocao dos dados de teste.
  ///
  /// `PENDING` e "ainda nao limpou", nunca "limpou e deu certo". `RESIDUAL`
  /// guarda em `cleanupResidue` o que ficou, com o ID gravado e a razao, para
  /// a tela dizer o que sobrou: limpeza parcial relatada como completa e falha
  /// de aceite, entao ela nao tem representacao neste schema.
  cleanupState   ActivationTestCleanupState @default(PENDING)
  cleanupAt      DateTime?
  cleanupResidue Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones ActivationTestMilestone[]

  @@unique([tenantId, id])
  @@index([tenantId, startedAt])
  @@index([tenantId, state])
  @@index([tenantId, cleanupState])
}

/// Marco alcancado por uma execucao, com a fonte do fato.
///
/// `factKind` e `factId` sao obrigatorios: e estruturalmente impossivel gravar
/// marco sem fonte. Progresso e derivado **destas linhas** — nunca de
/// temporizador, animacao ou texto fixo.
model ActivationTestMilestone {
  id        String                      @id @default(cuid())
  tenantId  String
  runId     String
  milestone ActivationTestMilestoneName
  reachedAt DateTime                    @default(now())

  factKind   ActivationTestFactKind
  factId     String
  factDetail Json?

  run ActivationTestRun @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, runId, milestone])
  @@index([tenantId, runId, reachedAt])
}

/// Registro de atividade do negocio (D-176): o que a profissional ou a IA
/// fizeram, com o antes e o depois de cada campo alterado. Gravado na mesma
/// transacao da mudanca, nunca editado — a trigger
/// `ActivityLog_append_only` recusa UPDATE. So sai pela purga do negocio
/// inteiro. Aqui ficam as conversas, o conhecimento do negocio e a memoria de
/// cliente; o BFF le junto com os registros do Scheduling e do proprio BFF.
model ActivityLog {
  id          String   @id @default(cuid())
  tenantId    String
  /// Desempate estrito dentro do mesmo `occurredAt` e cursor da leitura.
  sequence    BigInt   @unique @default(autoincrement())
  occurredAt  DateTime @default(now())
  /// `AI` ou `USER` (constraint SQL `ActivityLog_actor_type_check`).
  actorType   String
  /// Usuario quando `USER`; nulo para a IA.
  actorId     String?
  /// AGENDA, CUSTOMERS, SERVICES, SETTINGS, IMPORT ou CONVERSATIONS.
  area        String
  /// Verbo estavel em ingles (`appointment.rescheduled`); a frase em pt-BR e
  /// montada na tela.
  action      String
  entityType  String
  entityId    String?
  /// Nome legivel no momento do registro (cliente, servico); fonte da busca.
  entityLabel String?
  /// `[{ field, before, after }]` — so campos de uma lista permitida, nunca
  /// segredo, senha ou token.
  changes     Json     @default("[]")
  /// Contexto da frase (cliente, servicos, horario), sem segredo.
  details     Json?

  @@index([tenantId, occurredAt(sort: Desc), sequence(sort: Desc)])
}
