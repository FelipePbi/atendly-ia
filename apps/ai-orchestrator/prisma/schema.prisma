generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelProvider {
  EVOLUTION_GO
}

enum ChannelConnectionStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  CUSTOMER
  AI
  OWNER
}

enum ConversationStatus {
  ACTIVE
  HUMAN_HANDOFF
  CLOSED
}

enum AiRunStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum ToolCallStatus {
  STARTED
  SUCCEEDED
  FAILED
}

/// Estado de execucao do evento recebido na inbox duravel.
///
/// LEGACY marca as linhas gravadas antes do Goal004, quando ProcessedEvent
/// provava recebimento e nao conclusao: elas nao sao reprocessadas.
enum InboundEventStatus {
  RECEIVED
  PROCESSING
  DONE
  FAILED
  IGNORED
  LEGACY
}

/// Estado de entrega de uma saida (outbox). UNKNOWN e o unico estado que a
/// plataforma nao pode afirmar: so muda por reconciliacao.
enum MessageDeliveryState {
  PENDING
  SENT
  FAILED
  UNKNOWN
}

enum HandoffStatus {
  OPEN
  RESOLVED
}

/// As tres organizacoes da inbox. E atributo da sessao, nao do contato: um
/// contato pode abrir uma sessao comercial hoje e uma pessoal em outro mes.
enum SessionCategory {
  COMMERCIAL
  UNCLASSIFIED
  PERSONAL
}

/// De onde veio a categoria vigente da sessao. MANUAL e decisao da
/// profissional e prevalece sobre qualquer sugestao automatica.
enum CategorySource {
  AUTOMATIC
  MANUAL
}

/// Por onde o atendimento humano assumiu a sessao. Registrado para o painel
/// explicar o estado, nunca para mudar a decisao.
enum HumanControlSource {
  WHATSAPP
  ATENDLY
  BACKFILL
}

/// Estilo de conversa do negocio: influencia registro, emoji e informalidade,
/// nunca decisao operacional. Os tres valores do produto sao PROFESSIONAL,
/// BALANCED (default) e CASUAL. Os dois valores antigos continuam declarados
/// porque `ALTER TYPE ... ADD VALUE` nao remove valor do tipo do banco: eles
/// seguem legiveis e aceitos na entrada como alias normalizado ate o Goal024,
/// enquanto a saida ja usa so o vocabulario novo.
enum AiTone {
  PROFESSIONAL
  BALANCED
  CASUAL
  /// Legado, alias de PROFESSIONAL. Nenhuma linha nasce aqui.
  PROFESSIONAL_OBJECTIVE
  /// Legado, alias de BALANCED. Nenhuma linha nasce aqui.
  LIGHT_CLOSE
}

enum KnowledgeDocumentType {
  FAQ
  GUIDANCE
  CARE
  PROCEDURE
  BUSINESS_INFO
  TEXT_POLICY
}

enum KnowledgeDocumentStatus {
  ACTIVE
  INACTIVE
}

/// De onde vem uma linha de CustomerMemory. CUSTOMER_STATED e PROFESSIONAL sao
/// afirmacao humana; AI_INFERRED e a unica que carrega `confidence`.
enum CustomerMemoryOrigin {
  CUSTOMER_STATED
  AI_INFERRED
  PROFESSIONAL
}

/// Proposito de um AiRun. TURN e o turno normal de conversa (default, unico
/// valor que o binario anterior ao Goal012 escreve). SUGGESTION e SUMMARY sao
/// execucoes sem efeito sobre a conversa, so para auditoria.
enum AiRunKind {
  TURN
  SUGGESTION
  SUMMARY
}

/// Tipo de conteudo de uma `Message`. `TEXT` e o default: toda linha gravada
/// antes do Goal013 e todo turno de texto continuam TEXT sem backfill. Mídia
/// vem com uma linha em `MessageAttachment` (Goal013/WU-02).
enum MessageKind {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
  STICKER
  UNKNOWN
}

/// Kind da mídia anexada. Sem TEXT nem UNKNOWN: as duas nunca geram
/// `MessageAttachment`.
enum MessageAttachmentKind {
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
  STICKER
}

/// Estado da transcrição de uma mídia com áudio (Goal013/WU-03). PENDING e
/// SKIPPED não têm o mesmo significado: SKIPPED é decisão explícita (mídia
/// grande demais, tipo sem áudio), PENDING é fila.
enum TranscriptStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

model ChannelConnection {
  id                  String                  @id @default(cuid())
  tenantId            String
  userId              String
  provider            ChannelProvider
  externalInstanceId  String
  displayName         String?
  status              ChannelConnectionStatus @default(ACTIVE)
  metadata            Json?
  /// Projecao cifrada da credencial da instancia, entregue pelo BFF no
  /// provisionamento. Nula enquanto o vinculo nao foi reprovisionado.
  credentialCipher    String?
  credentialKeyId     String?
  credentialVersion   Int                     @default(0)
  credentialRotatedAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  conversations   Conversation[]
  messages        Message[]
  processedEvents ProcessedEvent[]
  aiRuns          AiRun[]
  handoffs        Handoff[]

  @@unique([provider, externalInstanceId])
  @@unique([tenantId, provider])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([credentialVersion])
}

model Conversation {
  id                 String             @id @default(cuid())
  tenantId           String
  channelId          String
  externalContactId  String
  customerName       String?
  currentIntent      String?
  state              Json?
  status             ConversationStatus @default(ACTIVE)
  humanHandoff       Boolean            @default(false)
  handoffPausedUntil DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  /// Vinculo com o Contato do canal. Opcional por compatibilidade: binario
  /// anterior ignora a coluna e o backfill preenche sem apagar nada.
  contactId String?

  channel  ChannelConnection     @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  contact  Contact?              @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: SetNull)
  messages Message[]
  aiRuns   AiRun[]
  handoffs Handoff[]
  sessions ConversationSession[]

  @@unique([tenantId, channelId, externalContactId])
  @@unique([tenantId, channelId, id])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, contactId])
}

/// Contato do canal.
///
/// Guarda o que e do contato e nao da conversa: identidade externa, perfil
/// predominante, `ignored` (regra absoluta, prevalece sobre a sessao) e a pausa
/// explicita da IA — `/bot off` e `/ia_pause` nao podem ser desfeitos por
/// expiracao de sessao nem por relogio.
///
/// Nao existe identidade de pessoa, nota, tag nem memoria estruturada aqui:
/// isso e dos Goals 006 e 012.
model Contact {
  id                String  @id @default(cuid())
  tenantId          String
  channelId         String
  externalContactId String
  displayName       String?

  /// Contato ignorado: a IA nunca atende, em nenhuma sessao. Guarda quando e
  /// por quem foi marcado, porque rollback nao pode desfazer a decisao.
  ignored       Boolean   @default(false)
  ignoredAt     DateTime?
  ignoredBy     String?
  ignoredSource String?

  /// Pausa explicita da IA para este contato (`/bot off`, `/ia_pause`). Vive
  /// no contato, e nao na sessao, para que a expiracao de ~24 h nao devolva a
  /// conversa a IA sem alguem ter pedido.
  aiPaused       Boolean   @default(false)
  aiPausedAt     DateTime?
  aiPausedReason String?

  /// Override manual de categoria. Prevalece sobre qualquer classificacao
  /// automatica e atravessa a troca de sessao.
  categoryOverride   SessionCategory?
  categoryOverrideAt DateTime?
  categoryOverrideBy String?

  /// Pessoa do Scheduling resolvida a partir deste contato, preenchida quando
  /// um agendamento e confirmado. Referencia por ID e tenant: nenhuma FK
  /// atravessa bancos. Um contato pode apontar para pessoas diferentes ao
  /// longo do tempo (mae que agenda para o filho) sem fundir contato nem
  /// cliente.
  customerId       String?
  customerLinkedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  sessions      ConversationSession[]

  @@unique([tenantId, channelId, externalContactId])
  @@unique([tenantId, id])
  @@index([tenantId, ignored])
  @@index([tenantId, customerId])
}

/// Sessao de conversa.
///
/// Janela de aproximadamente 24 h sem interacao do contato. A categoria
/// vigente, a sugestao automatica com proveniencia e o estado de atendimento
/// humano sao atributos dela; expirar abre uma sessao nova, que pode reavaliar
/// a intencao — nunca para contato ignorado.
model ConversationSession {
  id             String @id @default(cuid())
  tenantId       String
  channelId      String
  conversationId String
  contactId      String

  startedAt            DateTime  @default(now())
  /// Ultima interacao do contato. E ela, e nao a resposta da IA, que renova a
  /// sessao: cliente que sumiu deixa a sessao expirar.
  lastContactMessageAt DateTime?
  expiresAt            DateTime
  endedAt              DateTime?
  endedReason          String?

  category          SessionCategory @default(UNCLASSIFIED)
  categorySource    CategorySource  @default(AUTOMATIC)
  categoryUpdatedAt DateTime?
  categoryUpdatedBy String?

  /// Sugestao do agente, com proveniencia. Nunca vira override manual.
  suggestedCategory    SessionCategory?
  suggestionProvenance String?
  suggestedAt          DateTime?

  humanHandling       Boolean             @default(false)
  humanHandlingSince  DateTime?
  humanHandlingSource HumanControlSource?
  humanHandlingBy     String?

  /// `Retomar IA` marca aqui: o proximo turno reavalia o contexto a partir
  /// deste instante em vez de continuar do ponto anterior.
  contextResetAt DateTime?

  /// Versao de entrada da sessao. Incrementa a cada mensagem do contato e e
  /// comparada antes de executar tool com efeito e antes de enviar.
  inboundVersion Int @default(0)

  /// Marca de pendencia do backfill. Preenchida so quando o estoque legado era
  /// ambiguo; nao e usada para decidir nada em runtime.
  backfillNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [tenantId, channelId, conversationId], references: [tenantId, channelId, id], onDelete: Cascade)
  contact      Contact      @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  /// DIVERGENCIA DE SCHEMA CONHECIDA: existe tambem um indice unico **parcial**
  /// `ConversationSession_one_open_per_conversation` sobre
  /// `("tenantId","conversationId") WHERE "endedAt" IS NULL`, criado em SQL na
  /// migration `20260908171000_goal005_single_open_session`. O Prisma nao
  /// modela indice parcial, entao ele nao aparece aqui; `prisma migrate diff`
  /// vai relatar essa diferenca e ela e intencional.
  @@unique([tenantId, id])
  @@index([tenantId, conversationId, startedAt])
  @@index([tenantId, conversationId, endedAt])
  @@index([tenantId, category, humanHandling])
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  channelId         String
  conversationId    String
  externalMessageId String?
  direction         MessageDirection
  source            MessageSource?
  role              String
  body              String
  /// Tipo de conteudo (Goal013). Default TEXT: nao muda nada do estoque
  /// anterior a este Goal.
  kind              MessageKind      @default(TEXT)
  rawPayload        Json?
  createdAt         DateTime         @default(now())

  /// Operation-id estavel da tentativa de saida, gerado antes de chamar o
  /// transporte. Sobrevive a retry e e o que o recibo do Go reconcilia.
  correlationId     String?
  /// Nulo em INBOUND e no estoque anterior ao Goal004. O backfill marca
  /// OUTBOUND legado como UNKNOWN: nunca SENT presumido.
  deliveryState     MessageDeliveryState?
  deliveryDetail    String?
  deliveryAttempts  Int                   @default(0)
  deliveryUpdatedAt DateTime?

  channel      ChannelConnection   @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [tenantId, channelId, conversationId], references: [tenantId, channelId, id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@unique([tenantId, id])
  @@unique([tenantId, channelId, externalMessageId])
  @@unique([tenantId, channelId, correlationId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, deliveryState, deliveryUpdatedAt])
}

/// Mídia de uma `Message` (Goal013/WU-02). Nunca guarda bytes nem base64: só
/// metadados e, quando o provedor hospedou o arquivo, a URL. Os bytes vivem no
/// `ProcessedEvent.rawPayload` só enquanto o evento está pendente, ou são
/// buscados sob demanda (Goal013/WU-03) pelos campos do proto no `raw` do
/// canal.
model MessageAttachment {
  id              String                @id @default(cuid())
  tenantId        String
  messageId       String
  kind            MessageAttachmentKind
  mimetype        String?
  fileName        String?
  sizeBytes       Int?
  durationSeconds Int?
  mediaUrl        String?
  tooLarge        Boolean               @default(false)

  /// Preenchidos pelo Goal013/WU-03. Nascem nulos aqui: esta Work Unit so
  /// cria a linha, nao transcreve.
  transcript         String?
  transcriptStatus   TranscriptStatus?
  transcriptError    String?
  transcriptProvider String?
  transcriptModel    String?
  transcribedAt      DateTime?
  skipReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message Message @relation(fields: [tenantId, messageId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, messageId])
  /// Varredura por estado de transcrição dentro do tenant: fila pendente,
  /// retomada de falha e auditoria do que foi pulado por política
  /// (Goal013).
  @@index([tenantId, transcriptStatus])
}

/// Inbox duravel do transporte. A linha e gravada antes do ACK; o dedupe
/// (tenantId, provider, eventKey) continua valendo, agora acompanhado do
/// estado de execucao, do lease e do resultado.
model ProcessedEvent {
  id         String          @id @default(cuid())
  tenantId   String
  channelId  String
  provider   ChannelProvider
  eventKey   String
  messageId  String
  rawPayload Json?
  receivedAt DateTime        @default(now())

  /// Tipo tecnico do evento (Message, Receipt, Presence, ...). Determina se o
  /// evento vira trabalho de conversa, reconciliacao de entrega ou registro.
  eventType            String?
  /// Chave de serializacao: os eventos de uma mesma conversa executam um de
  /// cada vez; conversas distintas correm em paralelo.
  conversationKey      String?
  status               InboundEventStatus @default(RECEIVED)
  attempts             Int                @default(0)
  nextAttemptAt        DateTime?
  leaseOwner           String?
  /// Fencing: a conclusao so vale se o token continuar sendo o do claim.
  leaseToken           String?
  leaseExpiresAt       DateTime?
  /// Mensagem nova chegou enquanto a conversa executava: a resposta ainda nao
  /// enviada e reavaliada ou cancelada.
  supersedeRequestedAt DateTime?
  result               Json?
  error                String?
  completedAt          DateTime?

  channel ChannelConnection @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, provider, eventKey])
  @@index([tenantId, channelId, receivedAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([conversationKey, status, receivedAt])
}

model AiRun {
  id              String      @id @default(cuid())
  tenantId        String
  channelId       String
  conversationId  String
  provider        String
  model           String
  promptVersion   String
  inputMessageIds String[]
  status          AiRunStatus @default(STARTED)
  /// TURN e o turno de conversa normal; SUGGESTION e SUMMARY sao execucoes sem
  /// efeito sobre a conversa (Goal012), registradas so para auditoria.
  kind            AiRunKind   @default(TURN)
  outputText      String?
  error           String?
  startedAt       DateTime    @default(now())
  completedAt     DateTime?

  channel      ChannelConnection @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  conversation Conversation      @relation(fields: [tenantId, channelId, conversationId], references: [tenantId, channelId, id], onDelete: Cascade)
  toolCalls    AiToolCall[]

  @@unique([tenantId, id])
  @@index([tenantId, conversationId, startedAt])
}

model AiToolCall {
  id             String         @id @default(cuid())
  tenantId       String
  aiRunId        String
  externalCallId String?
  name           String
  arguments      Json
  result         Json?
  status         ToolCallStatus @default(STARTED)
  error          String?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  aiRun AiRun @relation(fields: [tenantId, aiRunId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, aiRunId, createdAt])
}

model Handoff {
  id                String        @id @default(cuid())
  tenantId          String
  channelId         String
  conversationId    String?
  externalContactId String
  reason            String
  summary           String?
  status            HandoffStatus @default(OPEN)
  createdAt         DateTime      @default(now())
  resolvedAt        DateTime?

  channel      ChannelConnection @relation(fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [tenantId, channelId, conversationId], references: [tenantId, channelId, id], onDelete: NoAction)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, channelId, externalContactId])
}

model AiTenantConfig {
  tenantId      String   @id
  enabled       Boolean  @default(false)
  tone          AiTone   @default(BALANCED)
  promptVersion String   @default("scheduling_v1.0.0")
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model KnowledgeDocument {
  id        String                  @id @default(cuid())
  tenantId  String
  type      KnowledgeDocumentType
  /// ID da pessoa/servico do Scheduling, sem FK entre bancos (mesmo padrao de
  /// `Contact.customerId`). Nulo significa documento geral, nao ligado a um
  /// servico especifico; documento legado (anterior ao Goal012) nasce geral.
  serviceId String?
  title     String
  source    String
  version   String
  checksum  String
  status    KnowledgeDocumentStatus @default(ACTIVE)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  chunks KnowledgeChunk[]

  @@unique([tenantId, id])
  @@unique([tenantId, type, source, version])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, serviceId])
}

/// Memoria do cliente, por `(tenantId, customerId)` da pessoa do Scheduling
/// (sem FK entre bancos). Cada linha e um fato observado, nunca sobrescrito:
/// contradicao nova marca `supersededById` na linha anterior em vez de apagar,
/// e a profissional remove marcando `removedAt`/`removedBy`. `aiAllowed`
/// decide se a linha pode entrar no prompt; a inferencia e a carga no prompt
/// sao do Goal012/WU-03, nao deste modulo.
model CustomerMemory {
  id                   String               @id @default(cuid())
  tenantId             String
  customerId           String
  kind                 String
  value                String
  origin               CustomerMemoryOrigin
  aiAllowed            Boolean              @default(false)
  /// So preenchido quando `origin = AI_INFERRED`.
  confidence           Float?
  sourceConversationId String?
  sourceMessageIds     String[]             @default([])
  observedAt           DateTime             @default(now())
  lastReinforcedAt     DateTime?
  /// ID de outra linha de CustomerMemory que substitui esta (mesmo tenant e
  /// cliente). Sem FK: a substituicao e responsabilidade de quem grava.
  supersededById       String?
  removedAt            DateTime?
  removedBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@index([tenantId, customerId, removedAt])
}

model KnowledgeChunk {
  id         String                      @id @default(cuid())
  tenantId   String
  documentId String
  content    String
  metadata   Json?
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  document KnowledgeDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, documentId])
}
