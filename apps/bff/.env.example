NODE_ENV=development
PORT=3002

# Banco usado pelo BFF para usuarios, sessoes e configuracoes da plataforma.
DATABASE_URL=postgresql://user:password@localhost:5432/avenly_bff?sslmode=disable
# Conexao direta para Prisma Migrate (prisma.config.ts), em Neon nao use o
# hostname -pooler. Lida so pelo Prisma CLI, fora do schema validado de
# config/env.ts; sem ela o deploy cai para DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/avenly_bff?sslmode=disable

# Gere um valor forte em producao.
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN=7d
# Nomes dos cookies. O BFF ainda le atendly_session/atendly_csrf, os nomes
# anteriores, na falta dos configurados; quem estabelece sessao apaga os antigos.
SESSION_COOKIE_NAME=avenly_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Origem permitida para CORS.
FRONTEND_ORIGIN=http://localhost:3001

# Servicos internos.
AI_ORCHESTRATOR_BASE_URL=http://localhost:3000
SCHEDULING_SERVICE_BASE_URL=http://localhost:3003
EVOLUTION_GO_BASE_URL=http://localhost:8080
EVOLUTION_GO_API_KEY=
INTERNAL_SERVICE_TOKEN=
INTERNAL_HTTP_TIMEOUT_MS=10000
INTERNAL_HTTP_GET_RETRIES=2
INTERNAL_HTTP_MEDIA_MAX_BYTES=33554432
INTERNAL_HTTP_MEDIA_TIMEOUT_MS=90000

# Janela minima entre duas reconciliacoes da central de notificacoes do mesmo
# negocio (Goal022).
NOTIFICATIONS_RECONCILE_MIN_INTERVAL_SECONDS=60

# Recuperação de senha. Delivery URL recebe POST JSON com to/resetUrl/expiresAt.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_PUBLIC_URL=http://localhost:3001/nova-senha
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=

# Token compartilhado com EVOLUTION_WEBHOOK_TOKEN no AI Orchestrator.
EVOLUTION_WEBHOOK_SECRET=change-me

# Varredura de retencao (Goal023). DESLIGADA por default e por escolha: purga e
# destrutiva, e ligar por omissao apagaria conteudo de negocio sem ninguem ter
# pedido. Desligada, nenhuma rota, leitura ou tela muda de comportamento.
RETENTION_SWEEP_ENABLED=false
# Intervalo entre passadas quando a anterior nao deixou trabalho restante.
RETENTION_SWEEP_INTERVAL_SECONDS=900
# Validade do lease por negocio, pelo relogio do banco.
RETENTION_SWEEP_LEASE_TTL_SECONDS=300
# Quantos negocios uma passada tenta varrer.
RETENTION_SWEEP_TENANT_BATCH=20
# Teto de linhas por store, por negocio, por passada.
RETENTION_SWEEP_MAX_ROWS_PER_STORE=500
# Piso entre duas passadas completas do mesmo negocio. Passada que parou no teto
# (restou trabalho) nao espera este piso: sobra e continuacao, nao repeticao.
RETENTION_SWEEP_MIN_TENANT_INTERVAL_SECONDS=3600
# Prazo TECNICO do conteudo das intencoes de lembrete (`facts`/`detail`). Nao e
# escolha da profissional e nao aparece na interface: rastro de execucao do
# envio nao carrega a categoria da sessao e por isso nao herda o prazo de
# Configuracoes -> Conversas. A linha da intencao nunca e apagada.
RETENTION_INTENT_CONTENT_DAYS=90

# Purga da conta vencida (Goal025). Variavel PROPRIA, separada da varredura
# acima: ligar a expiracao de conteudo nao pode ligar, por consequencia, o
# apagamento de contas inteiras. DESLIGADA por default pelo mesmo motivo do
# Goal023, agora mais forte — a passada apaga o negocio nas tres lojas e o dono
# por ultimo.
ACCOUNT_PURGE_ENABLED=false
# Intervalo entre passadas quando a anterior nao deixou trabalho restante.
ACCOUNT_PURGE_INTERVAL_SECONDS=900
# Validade do lease por conta, pelo relogio do banco, com fencing por token.
ACCOUNT_PURGE_LEASE_TTL_SECONDS=300
# Quantas contas uma passada tenta purgar.
ACCOUNT_PURGE_BATCH=5
# Teto de linhas por loja remota, por conta, por passada. O que passar dele
# volta como trabalho restante e a conta continua agendada ate concluir.
ACCOUNT_PURGE_MAX_ROWS_PER_STORE=2000

# Sessao revogavel: TTL da sessao no servidor e cookie legivel do token de CSRF.
SESSION_TTL_HOURS=168
CSRF_COOKIE_NAME=avenly_csrf
CSRF_HEADER_NAME=x-csrf-token

# Credenciais internas por chamador/uso. Vazias, sao derivadas de
# INTERNAL_SERVICE_TOKEN por HMAC; o valor bruto nunca e aceito por um receptor.
AI_ORCHESTRATOR_PROVISIONING_TOKEN=
AI_ORCHESTRATOR_COMMAND_TOKEN=
SCHEDULING_SERVICE_COMMAND_TOKEN=

# Cifra da credencial da instancia WhatsApp. Formato "<keyId>:<chave base64 de
# 32 bytes>", separadas por virgula. Rotacao: adicione a chave nova e aponte
# WHATSAPP_CREDENTIAL_ACTIVE_KEY_ID para ela; so remova a antiga depois de o
# estoque ter sido regravado. Gere com: openssl rand -base64 32
WHATSAPP_CREDENTIAL_KEYS=v1:
WHATSAPP_CREDENTIAL_ACTIVE_KEY_ID=v1
