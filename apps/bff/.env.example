NODE_ENV=development
PORT=3002

# Banco usado pelo BFF para usuarios, sessoes e configuracoes da plataforma.
DATABASE_URL=postgresql://user:password@localhost:5432/atendly_bff?sslmode=disable

# Gere um valor forte em producao.
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=atendly_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Origem permitida para CORS.
FRONTEND_ORIGIN=http://localhost:3001

# Servicos internos.
AI_ORCHESTRATOR_BASE_URL=http://localhost:3000
SCHEDULING_SERVICE_BASE_URL=http://localhost:3003
EVOLUTION_GO_BASE_URL=http://localhost:8080
EVOLUTION_GO_API_KEY=
INTERNAL_SERVICE_TOKEN=
INTERNAL_HTTP_TIMEOUT_MS=10000
INTERNAL_HTTP_GET_RETRIES=2

# Recuperação de senha. Delivery URL recebe POST JSON com to/resetUrl/expiresAt.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_PUBLIC_URL=http://localhost:3001/nova-senha
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=

# Token compartilhado com EVOLUTION_WEBHOOK_TOKEN no AI Orchestrator.
EVOLUTION_WEBHOOK_SECRET=change-me
