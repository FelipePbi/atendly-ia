NODE_ENV=development
PORT=3002

# Banco usado pelo BFF para usuarios, sessoes e configuracoes da plataforma.
DATABASE_URL=postgresql://user:password@localhost:5432/atendly_bff?sslmode=disable
# Conexao direta para Prisma Migrate; em Neon, nao use o hostname -pooler.
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/atendly_bff?sslmode=disable

# Gere um valor forte em producao.
JWT_SECRET=change-me-with-at-least-32-characters
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=atendly_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Origem permitida para CORS.
FRONTEND_ORIGIN=http://localhost:3001

# Servicos internos.
AI_ORCHESTRATOR_BASE_URL=http://localhost:3000
SCHEDULING_SERVICE_BASE_URL=http://localhost:3003
EVOLUTION_GO_BASE_URL=http://localhost:8080
EVOLUTION_GO_API_KEY=
INTERNAL_SERVICE_TOKEN=
INTERNAL_HTTP_TIMEOUT_MS=10000
INTERNAL_HTTP_GET_RETRIES=2
INTERNAL_HTTP_MEDIA_MAX_BYTES=33554432

# Recuperação de senha. Delivery URL recebe POST JSON com to/resetUrl/expiresAt.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_PUBLIC_URL=http://localhost:3001/nova-senha
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=

# Token compartilhado com EVOLUTION_WEBHOOK_TOKEN no AI Orchestrator.
EVOLUTION_WEBHOOK_SECRET=change-me

# Sessao revogavel: TTL da sessao no servidor e cookie legivel do token de CSRF.
SESSION_TTL_HOURS=168
CSRF_COOKIE_NAME=atendly_csrf
CSRF_HEADER_NAME=x-csrf-token

# Credenciais internas por chamador/uso. Vazias, sao derivadas de
# INTERNAL_SERVICE_TOKEN por HMAC; o valor bruto nunca e aceito por um receptor.
AI_ORCHESTRATOR_PROVISIONING_TOKEN=
AI_ORCHESTRATOR_COMMAND_TOKEN=
SCHEDULING_SERVICE_COMMAND_TOKEN=

# Cifra da credencial da instancia WhatsApp. Formato "<keyId>:<chave base64 de
# 32 bytes>", separadas por virgula. Rotacao: adicione a chave nova e aponte
# WHATSAPP_CREDENTIAL_ACTIVE_KEY_ID para ela; so remova a antiga depois de o
# estoque ter sido regravado. Gere com: openssl rand -base64 32
WHATSAPP_CREDENTIAL_KEYS=v1:
WHATSAPP_CREDENTIAL_ACTIVE_KEY_ID=v1
