generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WhatsAppInstanceStatus {
  CREATED
  CONNECTING
  WAITING_QR
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
  QR_EXPIRED
  ERROR
}

/// Estilo de conversa da IA: influencia registro, emoji e informalidade, nunca
/// decisao operacional. Os tres valores do produto (Goal011) sao PROFESSIONAL,
/// BALANCED e CASUAL. Os dois valores antigos continuam declarados porque
/// `ALTER TYPE ... ADD VALUE` nao remove valor do tipo do banco: eles seguem
/// legiveis e aceitos na entrada como alias normalizado ate o Goal024, enquanto
/// a saida ja usa so o vocabulario novo.
///
/// DIVERGENCIA DE SCHEMA INTENCIONAL: o Prisma geraria `CREATE TYPE` novo com a
/// lista final de valores, o que reescreveria a coluna e derrubaria o binario
/// anterior. `prisma migrate diff` pode relatar a ordem/composicao dos valores;
/// a diferenca e esperada e nao deve ser "corrigida" recriando o tipo.
enum AiTone {
  PROFESSIONAL
  BALANCED
  CASUAL
  /// Legado, alias de PROFESSIONAL. Nenhuma linha nasce aqui.
  PROFESSIONAL_OBJECTIVE
  /// Legado, alias de BALANCED. Nenhuma linha nasce aqui.
  LIGHT_CLOSE
}

enum TenantRole {
  OWNER
}

/// Modalidade de atendimento do negocio (Goal018/WU-01). Selecao multipla,
/// gravada como lista de enum no Postgres — vazio e distinto de nulo por
/// constraint de coluna (NOT NULL DEFAULT '{}'), nunca por convencao de JSON.
enum BusinessModality {
  ON_SITE
  AT_HOME
  ONLINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  whatsappInstance    WhatsAppInstance?
  legalAcceptances    LegalAcceptance[]
  passwordResetTokens PasswordResetToken[]
  tenantMemberships   TenantMember[]
  sessions            UserSession[]
}

/// Identidade de sessão revogável consultada a cada autenticação. O JWT carrega
/// apenas o `sid`; expiração, revogação e o segredo de CSRF vivem aqui, de modo
/// que logout e troca de senha invalidam cookie e Bearer no servidor.
model UserSession {
  id            String    @id @default(cuid())
  userId        String
  csrfTokenHash String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          TenantMember[]
  businessProfile  BusinessProfile?
  aiSettings       AiSettings?
  whatsappInstance WhatsAppInstance?

  notifications          TenantNotification[]
  notificationPreference NotificationPreference?
  notificationSyncState  NotificationSyncState?
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(OWNER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model BusinessProfile {
  id                    String             @id @default(cuid())
  tenantId              String             @unique
  businessName          String             @default("")
  category              String?
  timezone              String             @default("America/Sao_Paulo")
  language              String             @default("pt-BR")
  currency              String             @default("BRL")
  /// Selecao multipla, nunca fabricada por backfill; vazia por default.
  modalities            BusinessModality[] @default([])
  /// Nulo enquanto o negocio nao tem local proprio. So exigido (nao vazio)
  /// quando `modalities` contem ON_SITE; retirar ON_SITE nao apaga o valor.
  address               String?
  /// Contador simples incrementado a cada mudanca de dado de negocio (nome,
  /// categoria, timezone, modalidade, endereco) — nunca timestamp, que empata
  /// sob relogio grosso.
  businessContextVersion          Int      @default(1)
  /// Ultima versao efetivamente projetada para a IA por outra Work Unit deste
  /// Goal. Nasce atras da corrente (default 0 contra 1) para toda linha, nova
  /// ou existente: o contexto ganhou campos que ainda nao foram projetados.
  businessContextProjectedVersion Int      @default(0)
  onboardingCompletedAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LegalAcceptance {
  id                   String   @id @default(cuid())
  userId               String
  termsVersion         String
  privacyPolicyVersion String
  acceptedAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyPolicyVersion])
  @@index([acceptedAt])
}

model WhatsAppInstance {
  id     String @id @default(cuid())
  userId String @unique
  /// Dono de negócio do vínculo. Nulo apenas para estoque legado cuja
  /// proveniência ficou ambígua na migração: essas linhas não autorizam uso.
  tenantId String? @unique
  evolutionInstanceId    String?
  evolutionInstanceName  String                 @unique
  /// Envelope cifrado `v1.<keyId>.<iv>.<ct>` a partir de credentialVersion >= 1.
  /// credentialVersion 0 identifica o estoque legado ainda em texto puro.
  evolutionInstanceToken String
  credentialKeyId        String?
  credentialVersion      Int                    @default(0)
  credentialRotatedAt    DateTime?
  phoneNumber            String?
  status                 WhatsAppInstanceStatus @default(CREATED)
  qrcode                 String?
  connectedAt            DateTime?
  lastOwnerActivityAt    DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([evolutionInstanceId])
  @@index([status])
  @@index([credentialVersion])
}

model AiSettings {
  id       String  @id @default(cuid())
  tenantId String  @unique
  enabled  Boolean @default(false)
  /// Nulo enquanto o negocio nao escolheu um estilo: onboarding trata isso como
  /// pendencia (`AI_TONE_NOT_SELECTED`). Por isso a coluna nao tem `@default` —
  /// diferente de `AiTenantConfig.tone` na IA, aqui o equilibrado so vale como
  /// projecao enviada a IA quando o negocio ainda nao escolheu, nunca como valor
  /// gravado silenciosamente para esta linha.
  tone      AiTone?
  /// Execucao do teste real que autorizou a ativacao automatica (Goal019).
  ///
  /// Nulo e "nao foi ligada por teste" — nunca "o teste falhou". Guarda o ID
  /// da execucao, e nao um booleano, porque duas perguntas dependem de
  /// **qual** execucao foi: reconciliar a mesma duas vezes nao pode ativar
  /// duas vezes, e trocar o WhatsApp invalida a execucao que autorizou, o que
  /// so e verificavel comparando o vinculo dela com o vinculo corrente.
  activatedByRunId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Espécie da notificação da central (Goal022). Vocabulário fechado: cada
/// espécie tem uma fonte, uma chave de dedupe e uma regra de resolução
/// declaradas em `modules/notifications/species.ts`. Espécie nova é decisão de
/// produto, não campo livre de chamador.
enum NotificationKind {
  CUSTOMER_WAITING_HUMAN
  REMINDER_FAILED
  IMPORT_COMPLETED
  AI_APPOINTMENT_CREATED
  WHATSAPP_DISCONNECTED
  AI_UNAVAILABLE
  SETUP_INCOMPLETE
}

/// Os tres niveis do produto. Derivado de `kind` por tabela fixa no codigo,
/// nunca escolhido por quem materializa.
enum NotificationLevel {
  INFO
  ATTENTION
  CRITICAL
}

/// `EVENT` aconteceu e fica no historico; `CONDITION` esta aberta ou foi
/// resolvida. So `CONDITION` recebe `resolvedAt`.
enum NotificationShape {
  EVENT
  CONDITION
}

/// Registro duravel da central de notificacoes (Goal022).
///
/// `(tenantId, dedupeKey)` e `@@unique` **no banco**: e essa chave, e nao
/// verificacao em codigo, que torna a materializacao idempotente —
/// reconciliar dez vezes a mesma fonte produz uma linha. `dedupeKey` deriva
/// da identidade do fato no dono (conversa, intencao, sessao de importacao,
/// `sequence` do evento) ou do par tenant+especie para as condicoes; nunca de
/// `now()`, de contador local ou do texto exibido.
///
/// `payload` guarda **apenas** o que a copy e o link precisam. Nunca telefone,
/// credencial, `facts` de intencao, `leaseToken` nem payload cru: o que nao
/// sai do dono nao passa a sair pelo BFF.
model TenantNotification {
  id         String            @id @default(cuid())
  tenantId   String
  kind       NotificationKind
  level      NotificationLevel
  shape      NotificationShape
  dedupeKey  String
  /// Identidade do alvo dentro da especie (conversa, compromisso, sessao).
  /// Nulo nas condicoes de tenant, que nao tem alvo alem do proprio negocio.
  subjectId  String?
  /// Instante do fato no dono, nunca o da materializacao.
  occurredAt DateTime
  readAt     DateTime?
  /// So `CONDITION`. Preenchido quando a fonte deixa de reportar a condicao;
  /// a linha permanece no historico, nada e deletado.
  resolvedAt DateTime?
  payload    Json              @default("{}")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  /// As tres leituras reais: nao lidas, condicoes abertas e historico recente.
  @@index([tenantId, readAt])
  @@index([tenantId, shape, resolvedAt])
  @@index([tenantId, occurredAt(sort: Desc)])
}

/// Preferencia humana da central. Hoje so `AI_APPOINTMENT_CREATED`, com
/// **default desligado** (vault: "default silencioso"). Sem canal de e-mail ou
/// push: campo que nenhuma camada honra nao entra no contrato.
model NotificationPreference {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  aiAppointmentCreated Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Throttle e cursores da reconciliacao, por negocio (Goal022). Persistido
/// porque a materializacao roda dentro de requisicao que ja existe: sem estado
/// no banco, cada requisicao releria tudo de novo.
///
/// `seededAt` e o instante da primeira reconciliacao do tenant e existe para
/// uma regra de produto: **nenhum negocio ganha notificacao retroativa**.
/// Evento anterior a ele avanca o cursor sem criar linha. Condicoes nao
/// dependem disso — sao estado corrente e nascem refletindo o agora.
model NotificationSyncState {
  id                       String    @id @default(cuid())
  tenantId                 String    @unique
  seededAt                 DateTime  @default(now())
  lastReconciledAt         DateTime?
  /// Cursor opaco `(dueAt, id)` devolvido pela leitura de falhas do Scheduling.
  reminderFailedCursor     String?
  /// `sequence` do ultimo `AppointmentEvent` ja lido. Texto porque e BigInt.
  aiAppointmentEventCursor String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
