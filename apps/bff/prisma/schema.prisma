generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WhatsAppInstanceStatus {
  CREATED
  CONNECTING
  WAITING_QR
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
  QR_EXPIRED
  ERROR
}

enum AiTone {
  PROFESSIONAL_OBJECTIVE
  LIGHT_CLOSE
}

enum TenantRole {
  OWNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  whatsappInstance    WhatsAppInstance?
  legalAcceptances    LegalAcceptance[]
  passwordResetTokens PasswordResetToken[]
  tenantMemberships   TenantMember[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         TenantMember[]
  businessProfile BusinessProfile?
  aiSettings      AiSettings?
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(OWNER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model BusinessProfile {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  businessName          String    @default("")
  category              String?
  timezone              String    @default("America/Sao_Paulo")
  language              String    @default("pt-BR")
  currency              String    @default("BRL")
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LegalAcceptance {
  id                   String   @id @default(cuid())
  userId               String
  termsVersion         String
  privacyPolicyVersion String
  acceptedAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyPolicyVersion])
  @@index([acceptedAt])
}

model WhatsAppInstance {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  evolutionInstanceId    String?
  evolutionInstanceName  String                 @unique
  evolutionInstanceToken String
  phoneNumber            String?
  status                 WhatsAppInstanceStatus @default(CREATED)
  qrcode                 String?
  connectedAt            DateTime?
  lastOwnerActivityAt    DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([evolutionInstanceId])
  @@index([status])
}

model AiSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  enabled   Boolean  @default(false)
  tone      AiTone?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
