generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WhatsAppInstanceStatus {
  CREATED
  CONNECTING
  WAITING_QR
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
  QR_EXPIRED
  ERROR
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  UNKNOWN
}

enum UserSex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum IgnoredContactSource {
  MANUAL
  EVOLUTION_CONTACT_IMPORT
  WHATSAPP_COMMAND
  CHAT_ACTION
  AUTO_SAFETY
  SYSTEM
}

enum AiSuppressionReason {
  GLOBAL_AI_DISABLED
  VIRTUAL_ATTENDANT_INCOMPLETE
  AWAY_TIMEOUT_NOT_REACHED
  IGNORED_CONTACT
  GROUP_CHAT
  HUMAN_HANDOFF
  COMMAND_RECEIVED
  INSTANCE_DISCONNECTED
}

enum VirtualAttendantPersona {
  CORPORATE
  WARM
  CUSTOM
}

enum VirtualAttendantActivationMode {
  ALWAYS
  AWAY_FROM_WHATSAPP
}

enum VirtualAttendantAwayScope {
  GLOBAL
  CONVERSATION
}

enum VirtualAttendantIdentityMode {
  PROFESSIONAL
  SEPARATE_ASSISTANT
}

enum VirtualAttendantAssistantSex {
  FEMALE
  MALE
}

enum CustomPersonaStatus {
  NOT_STARTED
  WAITING_UPLOADS
  PROCESSING
  READY
  FAILED
  NEEDS_PARTICIPANT
}

enum TenantRole {
  OWNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  whatsappInstance           WhatsAppInstance?
  conversations              Conversation[]
  messages                   Message[]
  ignoredContacts            IgnoredContact[]
  aiSuppressionLogs          AiSuppressionLog[]
  personaConversationImports PersonaConversationImport[]
  profile                    UserProfile?
  settings                   UserSettings?
  businessSettings           BusinessSettings?
  legalAcceptances           LegalAcceptance[]
  passwordResetTokens        PasswordResetToken[]
  tenantMemberships          TenantMember[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         TenantMember[]
  businessProfile BusinessProfile?
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantRole @default(OWNER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model BusinessProfile {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  businessName          String    @default("")
  category              String?
  timezone              String    @default("America/Sao_Paulo")
  language              String    @default("pt-BR")
  currency              String    @default("BRL")
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LegalAcceptance {
  id                   String   @id @default(cuid())
  userId               String
  termsVersion         String
  privacyPolicyVersion String
  acceptedAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyPolicyVersion])
  @@index([acceptedAt])
}

model UserProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  fullName                String
  birthDate               DateTime? @db.Date
  sex                     UserSex
  businessName            String
  whatsappPhoneRaw        String?
  whatsappPhoneNormalized String?
  onboardingCompletedAt   DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onboardingCompletedAt])
}

model WhatsAppInstance {
  id                     String                 @id @default(cuid())
  userId                 String                 @unique
  evolutionInstanceId    String?
  evolutionInstanceName  String                 @unique
  evolutionInstanceToken String
  phoneNumber            String?
  status                 WhatsAppInstanceStatus @default(CREATED)
  qrcode                 String?
  connectedAt            DateTime?
  lastOwnerActivityAt    DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  messages          Message[]
  ignoredContacts   IgnoredContact[]
  aiSuppressionLogs AiSuppressionLog[]

  @@index([evolutionInstanceId])
  @@index([status])
}

model Conversation {
  id                  String    @id @default(cuid())
  userId              String
  instanceId          String
  contactJid          String
  contactName         String?
  profilePictureUrl   String?
  lastMessagePreview  String?
  lastMessageAt       DateTime?
  unreadCount         Int       @default(0)
  archivedAt          DateTime?
  aiPaused            Boolean   @default(false)
  aiPausedReason      String?
  aiPausedUpdatedAt   DateTime?
  lastOwnerActivityAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance          WhatsAppInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages          Message[]
  aiSuppressionLogs AiSuppressionLog[]

  @@unique([userId, contactJid])
  @@index([userId, lastMessageAt])
  @@index([userId, archivedAt, lastMessageAt])
  @@index([userId, aiPaused])
  @@index([instanceId])
}

model Message {
  id                String      @id @default(cuid())
  conversationId    String
  userId            String
  instanceId        String
  externalMessageId String?
  fromMe            Boolean     @default(false)
  senderJid         String?
  senderName        String?
  type              MessageType @default(UNKNOWN)
  contentText       String?
  mediaType         String?
  mediaUrl          String?
  mediaBase64       String?
  timestamp         DateTime
  rawPayload        Json?
  createdAt         DateTime    @default(now())

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, timestamp])
  @@index([userId, timestamp])
  @@index([instanceId])
}

model UserSettings {
  id                                  String                         @id @default(cuid())
  userId                              String                         @unique
  aiEnabled                           Boolean                        @default(false)
  identityMode                        VirtualAttendantIdentityMode   @default(PROFESSIONAL)
  assistantName                       String?
  assistantSex                        VirtualAttendantAssistantSex?
  professionalSex                     VirtualAttendantAssistantSex   @default(FEMALE)
  personaType                         VirtualAttendantPersona?
  customInstructions                  String?
  activationMode                      VirtualAttendantActivationMode @default(ALWAYS)
  awayTimeoutMinutes                  Int?
  awayScope                           VirtualAttendantAwayScope?
  customPersonaStatus                 CustomPersonaStatus            @default(NOT_STARTED)
  customPersonaProfileJson            Json?
  customPersonaGeneratedAt            DateTime?
  virtualAttendantOnboardingCompleted Boolean                        @default(false)
  createdAt                           DateTime                       @default(now())
  updatedAt                           DateTime                       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PersonaConversationImport {
  id             String              @id @default(cuid())
  userId         String
  fileName       String
  fileSize       Int?
  status         CustomPersonaStatus @default(PROCESSING)
  extractedCount Int?
  errorMessage   String?
  createdAt      DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BusinessSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  businessName          String   @default("")
  professionalName      String?  @default("")
  businessAddress       String?  @default("")
  timezone              String   @default("America/Sao_Paulo")
  maxSlotsToOffer       Int      @default(3)
  availabilityDays      Int      @default(14)
  slotStepMinutes       Int      @default(30)
  appointmentLookupDays Int      @default(90)
  delayPolicy           String?  @default("")
  cancellationPolicy    String?  @default("")
  depositPolicy         String?  @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IgnoredContact {
  id                 String               @id @default(cuid())
  userId             String
  instanceId         String
  jid                String
  phoneNumber        String?
  displayName        String?
  pushName           String?
  businessName       String?
  source             IgnoredContactSource @default(MANUAL)
  reason             String?
  isActive           Boolean              @default(true)
  createdByUserId    String?
  createdByMessageId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([userId, instanceId, jid])
  @@index([userId, instanceId, isActive])
  @@index([instanceId, jid])
}

model AiSuppressionLog {
  id             String              @id @default(cuid())
  userId         String
  instanceId     String
  conversationId String?
  messageId      String?
  contactJid     String
  reason         AiSuppressionReason
  metadata       Json?
  createdAt      DateTime            @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance     WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, instanceId, contactJid])
  @@index([createdAt])
}
