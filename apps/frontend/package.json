{
  "name": "whatsapp-ai-inbox-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3001",
    "build": "next build",
    "build:release": "npm run legal:check && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "legal:check": "node scripts/check-legal-config.mjs",
    "test:ui": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@atendly-ia/legal-contract": "file:../../packages/legal-contract",
    "@atendly-ia/public-api-contract": "file:../../packages/public-api-contract",
    "clsx": "^2.1.1",
    "next": "^16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  }
}
