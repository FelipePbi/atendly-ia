NODE_ENV=development
PORT=3003

# Banco exclusivo do Scheduling Service.
DATABASE_URL=postgresql://app:app@localhost:5434/atendly_scheduling?sslmode=disable

# Token compartilhado somente entre servicos internos. Use valor forte fora do desenvolvimento.
INTERNAL_SERVICE_TOKEN=change-me-with-at-least-32-characters

# Chave base64 de 32 bytes para AES-256-GCM. Protege credenciais salvas por tenant.
# Gere com: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=

# Credenciais internas por chamador. Vazias, sao derivadas de
# INTERNAL_SERVICE_TOKEN por HMAC; o valor bruto nao e aceito como credencial.
BFF_COMMAND_TOKEN=
AI_ORCHESTRATOR_COMMAND_TOKEN=
