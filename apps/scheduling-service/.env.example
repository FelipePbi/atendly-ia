NODE_ENV=development
PORT=3003

# Banco exclusivo do Scheduling Service.
DATABASE_URL=postgresql://app:app@localhost:5434/atendly_scheduling?sslmode=disable

# Token compartilhado somente entre servicos internos. Use valor forte fora do desenvolvimento.
INTERNAL_SERVICE_TOKEN=change-me-with-at-least-32-characters

# Chave base64 de 32 bytes para AES-256-GCM. Protege credenciais salvas por tenant.
# Gere com: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=

# Origem Minha Agenda (Goal060, Goal082): endereco publico da API (default e o
# host de producao) e a credencial do cliente OAuth.
#
# MINHA_AGENDA_OAUTH_CLIENT_CREDENTIAL e a identificacao do app do portal
# Minha Agenda, usada no cabecalho `Authorization: Basic` do login. E igual
# para todo negocio e fornecida pela operacao da Avenly; nunca e pedida ao
# usuario. Aceita o valor com ou sem o prefixo `Basic `. Sem ela, a importacao
# da Minha Agenda fica indisponivel, o servico sobe normalmente e registra um
# aviso (warn) ao subir. `MINHA_AGENDA_CLIENT_REJECTED` no log quer dizer que o
# portal recusou o valor configurado. A linha continua vazia: o valor nunca
# entra no repositorio.
MINHA_AGENDA_API_BASE_URL=https://api.minhaagendaapp.com.br
MINHA_AGENDA_OAUTH_CLIENT_CREDENTIAL=

# Credenciais internas por chamador. Vazias, sao derivadas de
# INTERNAL_SERVICE_TOKEN por HMAC; o valor bruto nao e aceito como credencial.
BFF_COMMAND_TOKEN=
AI_ORCHESTRATOR_COMMAND_TOKEN=

# Politica unica de escrita da agenda (Goal008): tentativas de transacao
# Serializable antes de devolver erro proprio diante de aborto serializavel.
CALENDAR_WRITE_MAX_ATTEMPTS=3
# Hold de confirmacao (Goal008): segundos que um horario fica reservado.
CALENDAR_HOLD_TTL_SECONDS=300
# Conclusao automatica (Goal008): liga o loop que marca COMPLETED, com origem
# AUTO, os atendimentos confirmados cujo termino venceu ha
# CALENDAR_AUTO_COMPLETE_GRACE_MINUTES.
CALENDAR_AUTO_COMPLETE_ENABLED=true
CALENDAR_AUTO_COMPLETE_GRACE_MINUTES=30
CALENDAR_AUTO_COMPLETE_POLL_INTERVAL_MS=60000

# Tetos de serie finita (Goal009): nenhuma serie de bloqueio/compromisso nem
# de atendimento nasce sem limite.
BLOCK_SERIES_MAX_OCCURRENCES=104
APPOINTMENT_SERIES_MAX_OCCURRENCES=52
# Janela de ajuste da recorrencia de atendimento (Goal009).
APPOINTMENT_SERIES_ADJUST_WINDOW_DAYS=3

# Lease da execucao da importacao (Goal010): segundos que uma instancia detem
# a sessao antes de o lease vencer e ficar reivindicavel por outra.
IMPORT_LEASE_TTL_SECONDS=120

# Reivindicacao das intencoes de envio ao cliente (Goal021).
NOTIFICATION_CLAIM_BATCH_LIMIT=100
NOTIFICATION_CLAIM_TENANT_LIMIT=20
# Lease da entrega (Goal021), mesmo espirito de IMPORT_LEASE_TTL_SECONDS.
NOTIFICATION_LEASE_TTL_SECONDS=120
# Tentativas antes de a intencao virar falha auditavel (ATTEMPTS_EXHAUSTED).
NOTIFICATION_MAX_ATTEMPTS=3
