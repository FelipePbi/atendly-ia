generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CalendarSource {
  ATENDLY
  MINHA_AGENDA
}

enum IntegrationProvider {
  MINHA_AGENDA
}

enum AppointmentSource {
  AI
  USER
  INTEGRATION
}

enum ExternalEntityType {
  SERVICE
  CUSTOMER
  APPOINTMENT
  AVAILABILITY
}

enum PriceType {
  FIXED
  ON_REQUEST
}

model CalendarSettings {
  tenantId  String         @id
  source    CalendarSource
  timezone  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model IntegrationConnection {
  id                   String              @id @default(cuid())
  tenantId             String
  provider             IntegrationProvider
  status               String
  credentialsEncrypted Bytes
  config               Json
  lastSuccessfulSyncAt DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId, status])
}

/// Pessoa atendida pelo negocio.
///
/// A identidade e `(tenantId, id)`, nunca o telefone: o numero e opcional,
/// pode ser compartilhado por mais de uma pessoa do mesmo negocio (mae que
/// agenda para o filho) e serve apenas para **encontrar candidatos**. Nenhum
/// caminho funde, renomeia ou deduplica pessoas por telefone ou nome parecido
/// (D-005).
model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  name            String?
  phone           String?
  normalizedPhone String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments   Appointment[]
  notes          CustomerNote[]
  tags           CustomerTag[]
  /// Relacoes em que esta pessoa e a atendida (tem um responsavel).
  relations      CustomerRelation[] @relation("CustomerRelationSubject")
  /// Relacoes em que esta pessoa e a responsavel por outra.
  responsibleFor CustomerRelation[] @relation("CustomerRelationRelated")

  @@unique([tenantId, id])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, name])
}

/// Relacao entre pessoas. No MVP existe apenas o responsavel principal, um por
/// cliente.
enum CustomerRelationType {
  PRIMARY_GUARDIAN
}

/// A IA pode **propor** a relacao; ela so vira permanente depois de
/// confirmacao explicita do cliente ou da profissional.
enum CustomerRelationStatus {
  PROPOSED
  CONFIRMED
}

/// Quem originou ou confirmou a relacao. Proveniencia e atributo do registro.
enum CustomerRelationActor {
  AI
  PROFESSIONAL
  CUSTOMER
}

model CustomerRelation {
  id                String                 @id @default(cuid())
  tenantId          String
  /// Pessoa atendida.
  customerId        String
  /// Pessoa responsavel.
  relatedCustomerId String
  type              CustomerRelationType   @default(PRIMARY_GUARDIAN)
  status            CustomerRelationStatus @default(PROPOSED)
  proposedBy        CustomerRelationActor
  proposedByActor   String?
  proposedAt        DateTime               @default(now())
  confirmedBy       CustomerRelationActor?
  confirmedByActor  String?
  confirmedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  customer        Customer @relation("CustomerRelationSubject", fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  relatedCustomer Customer @relation("CustomerRelationRelated", fields: [tenantId, relatedCustomerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, customerId, type])
  @@index([tenantId, relatedCustomerId])
}

/// Observacao interna livre. `aiAuthorized` e atributo do registro, nao do
/// prompt: sem autorizacao explicita a nota nunca chega ao modelo.
model CustomerNote {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  body           String
  aiAuthorized   Boolean   @default(false)
  authorizedAt   DateTime?
  authorizedBy   String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, customerId, aiAuthorized])
}

/// Tag manual. Mesma regra de autorizacao das observacoes.
model CustomerTag {
  id           String    @id @default(cuid())
  tenantId     String
  customerId   String
  label        String
  aiAuthorized Boolean   @default(false)
  authorizedAt DateTime?
  authorizedBy String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, customerId, label])
  @@index([tenantId, customerId, aiAuthorized])
}

model Service {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  durationMinutes Int
  priceType       PriceType
  price           Decimal?  @db.Decimal(12, 2)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointmentItems AppointmentItem[]

  @@unique([tenantId, id])
  @@index([tenantId, active, name])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  tenantId  String
  dayOfWeek Int
  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, dayOfWeek, active])
}

model AvailabilityException {
  id        String    @id @default(cuid())
  tenantId  String
  date      DateTime  @db.Date
  startTime DateTime? @db.Time(0)
  endTime   DateTime? @db.Time(0)
  available Boolean
  reason    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, date])
}

model TimeBlock {
  id        String   @id @default(cuid())
  tenantId  String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startAt, endAt])
}

model Appointment {
  id         String            @id @default(cuid())
  tenantId   String
  customerId String
  source     AppointmentSource
  startAt    DateTime
  endAt      DateTime
  status     String
  createdBy  String
  comments   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  customer Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items    AppointmentItem[]

  @@unique([tenantId, id])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, customerId, startAt])
  @@index([tenantId, status, startAt])
}

model AppointmentItem {
  id                      String    @id @default(cuid())
  tenantId                String
  appointmentId           String
  serviceId               String
  serviceNameSnapshot     String
  durationMinutesSnapshot Int
  priceTypeSnapshot       PriceType
  priceSnapshot           Decimal?  @db.Decimal(12, 2)
  createdAt               DateTime  @default(now())

  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  service     Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, appointmentId])
  @@index([tenantId, serviceId])
}

model ExternalEntityMap {
  id         String              @id @default(cuid())
  tenantId   String
  provider   IntegrationProvider
  entityType ExternalEntityType
  internalId String
  externalId String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([tenantId, provider, entityType, externalId])
  @@index([tenantId, provider, entityType, internalId])
}

model MigrationJob {
  id                String         @id @default(cuid())
  tenantId          String
  requestedBy       String
  source            CalendarSource
  target            CalendarSource
  status            String
  progress           Int            @default(0)
  currentStep        String?
  summary            Json?
  warnings           Json           @default("[]")
  limitations        Json           @default("[]")
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  conflicts MigrationConflict[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
}

model MigrationConflict {
  id             String             @id @default(cuid())
  tenantId       String
  migrationJobId String
  entityType     ExternalEntityType
  status         String
  details        Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  migrationJob MigrationJob @relation(fields: [tenantId, migrationJobId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, migrationJobId, status])
}

model CalendarMutationIdempotency {
  id            String   @id @default(cuid())
  tenantId      String
  key           String
  operation     String
  requestHash   String
  status        String
  response      Json?
  lastErrorCode String?
  lockedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, status, updatedAt])
}
