generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CalendarSource {
  ATENDLY
  MINHA_AGENDA
}

enum IntegrationProvider {
  MINHA_AGENDA
}

enum AppointmentSource {
  AI
  USER
  INTEGRATION
}

/// Tipo da entidade **de destino** de um mapa de origem, e a chave de
/// idempotencia por item em `ExternalEntityMap`. `TIME_BLOCK` e
/// `AVAILABILITY_EXCEPTION` sao aditivos do Goal010: a origem ja marca
/// bloqueios (`isSlotBlocker`) e ausencias, que na Atendly viram `TimeBlock`
/// e `AvailabilityException`. Nenhum valor existente muda de significado.
enum ExternalEntityType {
  SERVICE
  CUSTOMER
  APPOINTMENT
  AVAILABILITY
  TIME_BLOCK
  AVAILABILITY_EXCEPTION
}

/// Quatro semanticas de preco. `FIXED` e `ON_REQUEST` preservam o significado
/// original (Goal002); `STARTING_AT` ("a partir de") e `NOT_INFORMED`
/// ("nao informado") sao novos no Goal007. Nenhum registro existente e
/// reclassificado.
enum PriceType {
  FIXED
  STARTING_AT
  ON_REQUEST
  NOT_INFORMED
}

/// Origem do estado de revisao de um servico sem duracao: importacao (Minha
/// Agenda) ou cadastro manual incompleto.
enum ServiceReviewOrigin {
  IMPORT
  MANUAL
}

/// Identidade visual do servico (Goal007): token estavel, nao cor livre, para
/// nao acoplar dado persistido a uma paleta de UI que pode mudar.
enum ServiceColorToken {
  ROSE
  AMBER
  EMERALD
  SKY
  VIOLET
  SLATE
}

/// Quem propos o hold (Goal008). So AI ou USER: a fonte externa (Minha
/// Agenda) recusa hold, e o SYSTEM nao propoe horario.
enum AppointmentHoldSource {
  AI
  USER
}

/// Origem da conclusao (Goal008): manual (profissional) ou automatica (loop
/// de conclusao trinta minutos apos o termino).
enum AppointmentCompletionOrigin {
  MANUAL
  AUTO
}

/// Tipo de evento do historico operacional do atendimento (Goal008). Cada
/// mutacao grava exatamente um evento, na mesma transacao do efeito.
enum AppointmentEventType {
  CREATED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
  FINAL_VALUE_SET
  PRESENCE_CONFIRMED
  HOLD_CONSUMED
  OVERLAP_OVERRIDE
}

/// Origem do evento (Goal008): quem/o que disparou a mutacao.
enum AppointmentEventSource {
  AI
  USER
  SYSTEM
  INTEGRATION
}

/// Tipo da entidade referenciada pelo efeito gravado na idempotencia
/// (Goal008): id de atendimento, hold ou bloqueio.
enum CalendarEffectEntityType {
  APPOINTMENT
  APPOINTMENT_HOLD
  TIME_BLOCK
  /// Goal009: a serie de atendimento e o efeito de uma unica mutacao, e e por
  /// ela que a chave idempotente recupera os N atendimentos criados juntos.
  APPOINTMENT_SERIES
}

/// Compromisso pessoal e bloqueio sao a mesma entidade (`TimeBlock`) com
/// semantica de produto diferente (Goal009): os dois ocupam tempo do mesmo
/// jeito, mas so `PERSONAL` e algo que a profissional marcou para si, nao
/// uma indisponibilidade operacional.
enum TimeBlockKind {
  BLOCK
  PERSONAL
}

/// Estado de uma serie de bloqueio/compromisso (Goal009). `ENDED` e o que
/// "editar desta data em diante" produz na serie antiga: ela para de gerar
/// ocorrencias novas, mas as ja materializadas no passado continuam intactas
/// — nunca ha serie infinita silenciosa nem reescrita do que ja aconteceu.
enum BlockSeriesStatus {
  ACTIVE
  ENDED
}

model CalendarSettings {
  tenantId  String         @id
  source    CalendarSource
  timezone  String
  /// Regras de oferta do negocio (Goal009), aplicadas pelo proprio motor de
  /// disponibilidade a toda oferta — a IA e o BFF nunca decidem granularidade
  /// nem antecedencia. Defaults sao o comportamento que o motor ja praticava
  /// antes deste Goal (sem antecedencia minima, noventa dias de horizonte,
  /// passo de trinta minutos), garantidos pela constraint SQL
  /// `CalendarSettings_offer_rules_check` no cabecalho da migration.
  minLeadMinutes     Int @default(0)
  maxLeadDays        Int @default(90)
  granularityMinutes Int @default(30)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model IntegrationConnection {
  id                   String              @id @default(cuid())
  tenantId             String
  provider             IntegrationProvider
  status               String
  credentialsEncrypted Bytes
  config               Json
  lastSuccessfulSyncAt DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  /// Sessoes de importacao que usaram esta conexao (Goal010). A conexao e
  /// o cofre da credencial, isolada por tenant; a sessao guarda so a
  /// identidade da conta de origem.
  importSessions ImportSession[]

  @@unique([tenantId, provider])
  // Unicidade tecnica que habilita a FK composta por tenant da sessao de
  // importacao. Aditiva: `id` ja e chave primaria, entao nenhuma linha
  // existente pode violar.
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

/// Pessoa atendida pelo negocio.
///
/// A identidade e `(tenantId, id)`, nunca o telefone: o numero e opcional,
/// pode ser compartilhado por mais de uma pessoa do mesmo negocio (mae que
/// agenda para o filho) e serve apenas para **encontrar candidatos**. Nenhum
/// caminho funde, renomeia ou deduplica pessoas por telefone ou nome parecido
/// (D-005).
model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  name            String?
  phone           String?
  normalizedPhone String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments   Appointment[]
  notes          CustomerNote[]
  tags           CustomerTag[]
  /// Relacoes em que esta pessoa e a atendida (tem um responsavel).
  relations      CustomerRelation[] @relation("CustomerRelationSubject")
  /// Relacoes em que esta pessoa e a responsavel por outra.
  responsibleFor CustomerRelation[] @relation("CustomerRelationRelated")
  /// Holds propostos para esta pessoa (Goal008); ausente enquanto a
  /// identidade nao foi resolvida (ver `AppointmentHold.contactRef`).
  holds          AppointmentHold[]

  @@unique([tenantId, id])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, name])
}

/// Relacao entre pessoas. No MVP existe apenas o responsavel principal, um por
/// cliente.
enum CustomerRelationType {
  PRIMARY_GUARDIAN
}

/// A IA pode **propor** a relacao; ela so vira permanente depois de
/// confirmacao explicita do cliente ou da profissional.
enum CustomerRelationStatus {
  PROPOSED
  CONFIRMED
}

/// Quem originou ou confirmou a relacao. Proveniencia e atributo do registro.
enum CustomerRelationActor {
  AI
  PROFESSIONAL
  CUSTOMER
}

model CustomerRelation {
  id                String                 @id @default(cuid())
  tenantId          String
  /// Pessoa atendida.
  customerId        String
  /// Pessoa responsavel.
  relatedCustomerId String
  type              CustomerRelationType   @default(PRIMARY_GUARDIAN)
  status            CustomerRelationStatus @default(PROPOSED)
  proposedBy        CustomerRelationActor
  proposedByActor   String?
  proposedAt        DateTime               @default(now())
  confirmedBy       CustomerRelationActor?
  confirmedByActor  String?
  confirmedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  customer        Customer @relation("CustomerRelationSubject", fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  relatedCustomer Customer @relation("CustomerRelationRelated", fields: [tenantId, relatedCustomerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, customerId, type])
  @@index([tenantId, relatedCustomerId])
}

/// Observacao interna livre. `aiAuthorized` e atributo do registro, nao do
/// prompt: sem autorizacao explicita a nota nunca chega ao modelo.
model CustomerNote {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  body           String
  aiAuthorized   Boolean   @default(false)
  authorizedAt   DateTime?
  authorizedBy   String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, customerId, aiAuthorized])
}

/// Tag manual. Mesma regra de autorizacao das observacoes.
model CustomerTag {
  id           String    @id @default(cuid())
  tenantId     String
  customerId   String
  label        String
  aiAuthorized Boolean   @default(false)
  authorizedAt DateTime?
  authorizedBy String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, customerId, label])
  @@index([tenantId, customerId, aiAuthorized])
}

model Service {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  /// Ausente apenas como pendencia de revisao (Goal007); nunca zero fabricado.
  durationMinutes Int?
  priceType       PriceType
  price           Decimal?  @db.Decimal(12, 2)
  active          Boolean   @default(true)
  /// Estado de revisao, separado de `active`. Em lockstep com
  /// `durationMinutes IS NULL` (constraint SQL `Service_review_check`):
  /// corrigir a duracao retira a pendencia.
  needsReview     Boolean             @default(false)
  reviewOrigin    ServiceReviewOrigin?
  description     String?
  colorToken      ServiceColorToken?
  /// Configuracao de catalogo (Goal007); sem efeito operacional na ocupacao
  /// ate o Goal009.
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes  Int @default(0)
  /// Recorrencia de referencia em dias; sem efeito operacional ate o Goal011.
  recurrenceIntervalDays Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointmentItems AppointmentItem[]

  @@unique([tenantId, id])
  @@index([tenantId, active, name])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  tenantId  String
  dayOfWeek Int
  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, dayOfWeek, active])
}

model AvailabilityException {
  id        String    @id @default(cuid())
  tenantId  String
  date      DateTime  @db.Date
  startTime DateTime? @db.Time(0)
  endTime   DateTime? @db.Time(0)
  available Boolean
  reason    String?
  /// Decisao humana explicita (Goal009): so preenchida quando uma
  /// indisponibilidade que cobre atendimento confirmado foi criada mesmo
  /// assim, por decisao humana. Ausente para o caso comum (sem conflito).
  decidedBy     String?
  decidedReason String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, date])
}

/// Serie finita de bloqueio ou compromisso pessoal (Goal009): regra semanal
/// materializada em `TimeBlock` no momento da criacao, nunca gerada sob
/// demanda — nao ha serie infinita silenciosa. `seriesEndDate` e
/// `occurrenceCount` sao mutuamente exclusivos (constraint SQL
/// `BlockSeries_termination_check`): a serie termina por data OU por
/// contagem, sempre uma das duas.
model BlockSeries {
  id       String        @id @default(cuid())
  tenantId String
  kind     TimeBlockKind @default(BLOCK)
  title    String?
  /// Dias da semana (0=domingo..6=sabado) em que a serie ocorre.
  daysOfWeek      Int[]
  startTime       DateTime  @db.Time(0)
  endTime         DateTime  @db.Time(0)
  seriesStartDate DateTime  @db.Date
  seriesEndDate   DateTime? @db.Date
  occurrenceCount Int?
  status          BlockSeriesStatus @default(ACTIVE)
  /// Serie que a sucedeu quando esta foi encerrada por "editar desta data em
  /// diante" (Goal009): a serie antiga nunca e reescrita, so encerrada.
  supersededById String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  occurrences TimeBlock[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model TimeBlock {
  id        String        @id @default(cuid())
  tenantId  String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  /// Compromisso pessoal ou bloqueio operacional (Goal009); `BLOCK` e o
  /// default porque todo `TimeBlock` anterior a este Goal era um bloqueio.
  kind      TimeBlockKind @default(BLOCK)
  title     String?
  seriesId  String?
  /// Data local da ocorrencia dentro da serie — a mesma unidade que
  /// "remover/mover uma ocorrencia" e "editar desta data em diante" operam
  /// sobre, sem recalcular a partir de `startAt` a cada leitura.
  occurrenceDate DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series BlockSeries? @relation(fields: [tenantId, seriesId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, startAt, endAt])
  @@index([tenantId, seriesId, occurrenceDate])
}

/// Serie finita de atendimento a partir de um servico (Goal009): so
/// referencia de leitura depois de confirmada — cancelar, remarcar ou
/// concluir uma ocorrencia nunca toca as outras (`Appointment.seriesId` e
/// opcional e sem cascata).
model AppointmentSeries {
  id            String   @id @default(cuid())
  tenantId      String
  serviceIds    Json
  intervalDays  Int
  occurrenceCount Int
  customerId    String?
  createdBy     String
  createdAt     DateTime @default(now())

  appointments Appointment[]

  @@unique([tenantId, id])
}

model Appointment {
  id         String            @id @default(cuid())
  tenantId   String
  customerId String
  source     AppointmentSource
  startAt    DateTime
  endAt      DateTime
  /// Estado do produto (Goal008): `CONFIRMED`/`COMPLETED`/`CANCELLED`/
  /// `NO_SHOW`, validado pela constraint SQL `Appointment_status_check`
  /// (fora do alcance do Prisma, que so tipa `String`). Antes do Goal008 o
  /// valor era `SCHEDULED`/`CANCELLED` gravado livremente pelo codigo; o
  /// valor pre-normalizacao fica em `statusRaw`.
  status     String
  /// Valor bruto do status anterior a normalizacao do Goal008
  /// (`SCHEDULED`/`CANCELLED`), preservado para auditoria. Nulo apenas para
  /// linhas criadas antes do passo de normalizacao rodar preencher o
  /// historico; o codigo do Goal008 em diante sempre grava os dois.
  statusRaw  String?
  /// Titulo do atendimento manual excepcional sem servico cadastrado
  /// (Goal008). Obrigatorio quando o atendimento nao tem nenhum
  /// `AppointmentItem` — ver a constraint trigger
  /// `Appointment_title_required_without_items` no cabecalho da migration,
  /// pois o Prisma nao expressa uma checagem entre tabelas.
  title      String?
  createdBy  String
  comments   String?
  /// Conclusao (Goal008): instante, ator e origem (manual ou automatica).
  completedAt      DateTime?
  completedBy      String?
  completionOrigin AppointmentCompletionOrigin?
  /// Falta (Goal008): instante e observacao opcional.
  noShowAt         DateTime?
  noShowNote       String?
  /// Presenca confirmada (Goal008); campo separado de `completedAt`,
  /// alimentado a partir do Goal021 (lembretes).
  presenceConfirmedAt DateTime?
  /// Valor final (Goal008): nunca inferido do preco previsto no acordo;
  /// registrado com data e ator quando informado explicitamente.
  finalValue       Decimal?  @db.Decimal(12, 2)
  finalValueSetAt  DateTime?
  finalValueSetBy  String?
  /// Ocupacao externa por buffer (Goal009), gravada como snapshot na
  /// confirmacao: o maior `bufferBeforeMinutes`/`bufferAfterMinutes` entre os
  /// servicos do atendimento naquele instante. Editar o catalogo depois nao
  /// move a ocupacao — o snapshot e a fonte, nunca o catalogo recalculado.
  /// Atendimento legado (anterior a este Goal) e manual sem servico recebem
  /// zero, o que o motor ja praticava.
  bufferBeforeMinutesSnapshot Int @default(0)
  bufferAfterMinutesSnapshot  Int @default(0)
  /// Serie de atendimento (Goal009), so referencia de leitura: nula fora de
  /// uma serie. Cancelar, remarcar ou concluir uma ocorrencia nunca toca as
  /// demais, entao nao ha cascata aqui.
  seriesId   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  customer Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items    AppointmentItem[]
  events   AppointmentEvent[]
  series   AppointmentSeries? @relation(fields: [tenantId, seriesId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, customerId, startAt])
  @@index([tenantId, status, startAt])
  @@index([tenantId, seriesId])
}

model AppointmentItem {
  id                      String    @id @default(cuid())
  tenantId                String
  appointmentId           String
  serviceId               String
  serviceNameSnapshot     String
  /// Ausente quando o item nao tem duracao propria conhecida (Goal007);
  /// nunca preenchida com a duracao total do atendimento.
  durationMinutesSnapshot Int?
  priceTypeSnapshot       PriceType
  priceSnapshot           Decimal?  @db.Decimal(12, 2)
  createdAt               DateTime  @default(now())

  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  service     Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, appointmentId])
  @@index([tenantId, serviceId])
}

/// Ocupacao temporaria de um horario enquanto ele esta em confirmacao
/// (Goal008), por cinco minutos (configuravel), validada pelo relogio do
/// banco. Conta como ocupacao na disponibilidade para todos, exceto para a
/// propria confirmacao que a consome; hold vencido e ignorado sem depender
/// de worker.
model AppointmentHold {
  id       String                @id @default(cuid())
  tenantId String
  startAt  DateTime
  endAt    DateTime
  /// Servicos propostos (ids) e duracao total proposta, em JSON: o hold e
  /// efemero (expira em minutos) e nao precisa da mesma modelagem
  /// relacional/snapshot do `AppointmentItem`, que e permanente.
  proposedServiceIds      Json
  proposedDurationMinutes Int
  /// Buffers propostos (Goal009): o maior `bufferBeforeMinutes`/
  /// `bufferAfterMinutes` entre os servicos propostos, na mesma semantica do
  /// snapshot do atendimento. Viram o snapshot definitivo se o hold for
  /// consumido; zero para hold sem servico (nao existe hoje, mas o default
  /// mantem a coluna alinhada ao atendimento).
  proposedBufferBeforeMinutes Int @default(0)
  proposedBufferAfterMinutes  Int @default(0)
  /// Pessoa ja identificada (Customer), quando existir.
  customerId String?
  /// Referencia livre a um contato ainda nao resolvido para um Customer
  /// (por exemplo telefone/canal da conversa) — a IA pode segurar um hold
  /// antes de a identidade do cliente estar confirmada (D-005: nenhuma
  /// fusao por telefone).
  contactRef String?
  source     AppointmentHoldSource
  /// TIMESTAMPTZ, nao TIMESTAMP: comparado a `now()` do banco em toda
  /// avaliacao de vigencia, e precisa continuar correto independente do
  /// fuso da sessao que grava ou le a linha.
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime?
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, startAt, endAt])
  @@index([tenantId, expiresAt])
}

/// Historico operacional do atendimento (Goal008): um evento por mutacao,
/// gravado na mesma transacao do efeito. Nunca apagado nem reescrito;
/// `updatedAt` do Appointment nao substitui este historico.
model AppointmentEvent {
  id            String                 @id @default(cuid())
  tenantId      String
  appointmentId String
  type          AppointmentEventType
  source        AppointmentEventSource
  actor         String?
  reason        String?
  /// Antes/depois (horario, status, valores) — forma livre por tipo de
  /// evento; leitura e sempre por atendimento, em ordem cronologica.
  before        Json?
  after         Json?
  occurredAt    DateTime               @default(now())
  /// Ordem real de gravacao (Goal008). `occurredAt` tem DEFAULT
  /// CURRENT_TIMESTAMP, que em Postgres e o instante de **inicio da
  /// transacao**: os eventos gravados juntos por uma mesma mutacao
  /// (`CREATED` + `OVERLAP_OVERRIDE` + `HOLD_CONSUMED`) recebem o mesmo
  /// valor. A leitura cronologica ordena por `occurredAt` e desempata por
  /// esta sequencia, entao "o que aconteceu antes" nunca depende da ordem
  /// fisica das linhas.
  sequence      BigInt                 @unique @default(autoincrement())

  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, appointmentId, occurredAt])
  @@index([tenantId, appointmentId, sequence])
}

model ExternalEntityMap {
  id         String              @id @default(cuid())
  tenantId   String
  provider   IntegrationProvider
  entityType ExternalEntityType
  internalId String
  externalId String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([tenantId, provider, entityType, externalId])
  @@index([tenantId, provider, entityType, internalId])
}

model MigrationJob {
  id                String         @id @default(cuid())
  tenantId          String
  requestedBy       String
  source            CalendarSource
  target            CalendarSource
  status            String
  progress           Int            @default(0)
  currentStep        String?
  summary            Json?
  warnings           Json           @default("[]")
  limitations        Json           @default("[]")
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt


  /// Classificacao do job legado (Goal010, U-02). Aditiva e conservadora:
  /// toda linha anterior a este Goal nasce `UNCLASSIFIED` e continua com o
  /// `status`, o `summary` e as datas que ja tinha. Classificar um job como
  /// `TECHNICAL_COMPLETED` **nao** e a conclusao de importacao do usuario e
  /// nao consome o direito do negocio; o que consome e uma `ImportSession`
  /// com `completedAt`. Nenhum job legado e apagado ou convertido.
  legacyClass        LegacyMigrationJobClass @default(UNCLASSIFIED)
  legacyClassifiedAt DateTime?
  legacyClassifiedBy String?
  /// Motivo sanitizado do isolamento quando `legacyClass = NEEDS_REVIEW`.
  legacyReviewReason String?

  conflicts MigrationConflict[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, legacyClass])
}

model MigrationConflict {
  id             String             @id @default(cuid())
  tenantId       String
  migrationJobId String
  entityType     ExternalEntityType
  status         String
  details        Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  migrationJob MigrationJob @relation(fields: [tenantId, migrationJobId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, migrationJobId, status])
}

/// Categoria de importacao (Goal010). E o eixo do **preview**, nao o da
/// entidade de destino: historico, cancelados e faltas sao categorias
/// distintas para o usuario ("1.840 atendimentos anteriores", "12
/// cancelamentos") e viram todos `Appointment` na Atendly. Por isso a
/// categoria e um enum proprio e nao reaproveita `ExternalEntityType`, que
/// continua sendo o eixo da entidade criada e a chave de idempotencia por
/// item em `ExternalEntityMap`.
enum ImportCategory {
  SERVICE
  CUSTOMER
  AVAILABILITY
  TIME_BLOCK
  FUTURE_APPOINTMENT
  PAST_APPOINTMENT
  CANCELLED_APPOINTMENT
  NO_SHOW_APPOINTMENT
}

/// Estados da sessao de importacao. Terminais: `COMPLETED` (a conclusao
/// unica e irreversivel do negocio), `FAILED` e `SUPERSEDED` (sessao
/// substituida antes de qualquer conclusao). Os demais sao vivos: uma
/// importacao `PARTIAL` permanece em andamento ate o usuario decidir
/// conclui-la.
enum ImportSessionStatus {
  DRAFT
  ANALYZING
  READY
  EXECUTING
  PARTIAL
  FAILED
  SUPERSEDED
  COMPLETED
}

/// Conjunto fechado de estados do item, conforme o Goal010. Alem do enum do
/// Postgres existe uma constraint SQL explicita (`ImportItem_status_check`),
/// pelo mesmo motivo do Goal008: o estado do item e invariante de banco, nao
/// convencao de codigo.
enum ImportItemStatus {
  PENDING
  IMPORTED
  SKIPPED
  FAILED
  NEEDS_REVIEW
}

/// Alcance de uma decisao do usuario: a sessao inteira ("importar tudo",
/// aceite de conclusao com pendentes), uma categoria ("escolher o que
/// importar") ou um item ("deixar de fora", "resolver divergencia").
enum ImportDecisionScope {
  SESSION
  CATEGORY
  ITEM
}

/// O que foi decidido. `MERGE_WITH_EXISTING`, `CREATE_NEW` e `KEEP_EXISTING`
/// so aparecem em decisao de item, na resolucao de divergencia: semelhanca
/// sugere, nunca funde sozinha (D-005 e Goal006).
enum ImportDecisionKind {
  IMPORT_ALL
  INCLUDE
  EXCLUDE
  MERGE_WITH_EXISTING
  CREATE_NEW
  KEEP_EXISTING
  ACCEPT_PENDING_COMPLETION
}

/// Classificacao de um `MigrationJob` **legado** (U-02). Nenhum job legado
/// consome o direito de importacao do negocio nem habilita uma segunda: o
/// direito e consumido apenas por uma `ImportSession` com `completedAt`, e
/// isso e estrutural, porque as duas tabelas nao se comunicam.
/// `UNCLASSIFIED` e o estado de toda linha que existia antes deste Goal;
/// `NEEDS_REVIEW` isola explicitamente o caso sem prova de conclusao.
enum LegacyMigrationJobClass {
  UNCLASSIFIED
  TECHNICAL_COMPLETED
  TECHNICAL_INCOMPLETE
  TECHNICAL_FAILED
  NEEDS_REVIEW
}

/// Sessao de importacao: uma por negocio, migracao assistida e nunca
/// sincronizacao. Guarda a identidade da conta de origem, a versao do
/// preview, o lease da execucao e a conclusao unica.
///
/// DIVERGENCIA DE SCHEMA CONHECIDA: o Prisma nao modela indice unico
/// **parcial**, entao duas garantias existem so em SQL, na migration
/// `20260910100000_goal010_import_session`, e `prisma migrate diff` vai
/// relata-las como diferenca esperada:
///   - `ImportSession_one_completed_per_tenant` sobre `("tenantId") WHERE
///     "completedAt" IS NOT NULL`, a conclusao unica e irreversivel por
///     negocio, recusada pelo banco mesmo sob duas conexoes concorrentes e
///     nao apenas pelo codigo;
///   - `ImportSession_one_live_per_tenant` sobre `("tenantId")` restrito aos
///     estados vivos (`DRAFT`, `ANALYZING`, `READY`, `EXECUTING`,
///     `PARTIAL`), que e a "uma sessao por negocio". Para substituir uma
///     sessao viva e preciso move-la para `SUPERSEDED` ou `FAILED` antes;
///     falha tecnica antes da conclusao nao consome o direito.
///
/// As constraints `ImportSession_completion_check`,
/// `ImportSession_counts_check` e `ImportSession_lease_check` tambem so
/// existem em SQL.
model ImportSession {
  id       String              @id @default(cuid())
  tenantId String
  provider IntegrationProvider @default(MINHA_AGENDA)

  /// Identidade da conta de origem, como a origem a identifica. Nao e
  /// credencial: o segredo continua cifrado com AAD em
  /// `IntegrationConnection.credentialsEncrypted` e nunca e copiado para ca.
  sourceAccountId String
  /// Rotulo exibivel da conta de origem (ja sanitizado). Opcional porque a
  /// origem pode nao fornecer nada alem do identificador.
  sourceAccountLabel String?
  /// Conexao usada para ler a origem. `Restrict`, nao `SetNull`: a FK e
  /// composta por tenant e `SET NULL` nulificaria tambem `tenantId`, que e
  /// NOT NULL. Desconectar a origem de importacao limpa a referencia da
  /// sessao antes de remover a conexao; o historico da importacao e
  /// permanente e nunca e apagado junto, e a agenda operacional nunca e
  /// desativada por isso.
  connectionId String?

  status ImportSessionStatus @default(DRAFT)

  /// Versao do preview. Reanalise **incrementa** e reconcilia as decisoes
  /// existentes por identificador de origem; nenhuma decisao e apagada.
  /// Executar referindo uma versao anterior a vigente e recusado com erro
  /// proprio (preview obsoleto).
  previewVersion     Int       @default(0)
  previewGeneratedAt DateTime?
  /// Impressao digital do que a origem devolveu no preview vigente. Muda
  /// quando a origem muda, mesmo que as contagens nao mudem.
  sourceFingerprint String?

  /// Contagens agregadas da sessao, mantidas na mesma transacao das
  /// mudancas de item. O detalhe por categoria vive em
  /// `ImportSessionCategory`: o produto nunca mostra uma contagem generica.
  pendingCount     Int @default(0)
  importedCount    Int @default(0)
  skippedCount     Int @default(0)
  failedCount      Int @default(0)
  needsReviewCount Int @default(0)

  /// Lease da execucao, pelo relogio do **banco**: `leaseExpiresAt` e
  /// TIMESTAMPTZ e e sempre gravado como `now() + intervalo` pelo servidor,
  /// nunca a partir do relogio do processo. Uma instancia so reivindica a
  /// sessao quando `leaseOwner IS NULL OR leaseExpiresAt <= now()`, entao
  /// dois starts simultaneos, duas instancias ou um reinicio no meio do
  /// lote nao duplicam trabalho nem reiniciam job vivo.
  leaseOwner       String?
  leaseAcquiredAt  DateTime? @db.Timestamptz(3)
  leaseExpiresAt   DateTime? @db.Timestamptz(3)
  leaseHeartbeatAt DateTime? @db.Timestamptz(3)

  startedAt  DateTime?
  finishedAt DateTime?

  /// Conclusao unica e irreversivel do negocio. Preenchidos juntos e apenas
  /// quando `status = COMPLETED` (`ImportSession_completion_check`), e uma
  /// segunda conclusao no mesmo tenant e recusada pelo indice unico parcial.
  completedAt DateTime?
  completedBy String?

  /// Aceite explicito de concluir com pendentes, com autor, data e a
  /// contagem no momento da decisao. Sem ele, a conclusao com pendentes e
  /// recusada pelo banco.
  pendingAcceptedAt    DateTime?
  pendingAcceptedBy    String?
  pendingAcceptedCount Int?

  /// Motivo sanitizado da falha. Nunca segredo, credencial ou payload cru
  /// da origem.
  errorCode    String?
  errorMessage String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connection IntegrationConnection? @relation(fields: [tenantId, connectionId], references: [tenantId, id], onDelete: Restrict)
  categories ImportSessionCategory[]
  items      ImportItem[]
  decisions  ImportDecision[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, leaseExpiresAt])
  @@index([tenantId, provider, sourceAccountId])
}

/// Cobertura, limitacao e checkpoint de uma categoria dentro da sessao.
///
/// `sourceReportedCount` e `readCount` sao a cobertura explicita do Goal010:
/// quanto a origem declarou existir e quanto foi efetivamente lido. Quando a
/// origem nao fornece a categoria, `sourceSupported` e falso e
/// `limitationCode` e obrigatorio (`ImportSessionCategory_limitation_check`):
/// a limitacao e declarada e quantificada, e nenhum dado e fabricado no
/// lugar do que falta.
model ImportSessionCategory {
  id        String         @id @default(cuid())
  tenantId  String
  sessionId String
  category  ImportCategory

  /// `Importar tudo` e o caminho principal: toda categoria nasce
  /// selecionada e `Escolher o que importar` desmarca.
  selected Boolean @default(true)

  sourceSupported  Boolean @default(true)
  limitationCode   String?
  limitationDetail String?

  /// Nulo quando a origem nao declara total. Nao e zero: zero seria uma
  /// afirmacao que a origem nao fez.
  sourceReportedCount Int?
  readCount           Int  @default(0)
  discoveredCount     Int  @default(0)

  pendingCount     Int @default(0)
  importedCount    Int @default(0)
  skippedCount     Int @default(0)
  failedCount      Int @default(0)
  needsReviewCount Int @default(0)

  /// Checkpoint persistido da paginacao/execucao desta categoria: queda no
  /// meio retoma daqui, sem duplicar. Nunca guarda payload cru da origem.
  cursor       Json?
  checkpointAt DateTime?

  previewVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session ImportSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, category])
  @@index([tenantId, sessionId, selected])
}

/// Um registro analisado da origem. A identidade dentro da sessao e
/// `(tenantId, sessionId, category, externalId)`, e e ela que permite a
/// reanalise reconciliar decisoes por identificador de origem. Isso **nao**
/// e uma chave de idempotencia paralela: a idempotencia da criacao continua
/// sendo `ExternalEntityMap (tenantId, provider, entityType, externalId)`, e
/// reprocessar o mesmo registro nao cria um segundo na Atendly.
model ImportItem {
  id        String         @id @default(cuid())
  tenantId  String
  sessionId String
  category  ImportCategory
  /// Identificador do registro na origem.
  externalId String
  /// Rotulo curto ja sanitizado, para o preview e o relatorio.
  label String?

  status ImportItemStatus @default(PENDING)
  /// Motivo sanitizado: codigo estavel e texto legivel. Nunca segredo,
  /// credencial ou payload cru da origem.
  reasonCode   String?
  reasonDetail String?

  /// Referencia ao registro criado na Atendly, quando houver. Preenchidos
  /// juntos e obrigatorios em `IMPORTED`
  /// (`ImportItem_status_consistency_check`).
  entityType ExternalEntityType?
  internalId String?

  /// Impressao digital do registro na origem; muda quando a reanalise ve o
  /// mesmo identificador com conteudo diferente.
  fingerprint String?

  firstSeenPreviewVersion Int @default(0)
  lastSeenPreviewVersion  Int @default(0)
  /// Quando o item deixou de aparecer na origem entre duas analises. A
  /// linha nao e apagada: a reanalise declara o que mudou.
  disappearedAt DateTime?

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session   ImportSession    @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)
  decisions ImportDecision[]

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, category, externalId])
  @@index([tenantId, sessionId, status])
  @@index([tenantId, sessionId, category, status])
}

/// Decisao do usuario, por item ou por categoria, com autor e data.
///
/// A tabela e **append-only**: uma nova analise nunca apaga decisao, e uma
/// decisao posterior sobre o mesmo alvo apenas supera a anterior na leitura
/// (ultima por `decidedAt`, `id`). `externalId` e guardado junto com
/// `itemId` de proposito: e por ele que a reconciliacao apos reanalise
/// reencontra a decisao quando o item ganha uma linha nova.
model ImportDecision {
  id        String              @id @default(cuid())
  tenantId  String
  sessionId String
  scope     ImportDecisionScope
  decision  ImportDecisionKind

  category   ImportCategory?
  itemId     String?
  externalId String?

  /// Versao do preview em que a decisao foi tomada.
  previewVersion Int @default(0)

  /// Alvo escolhido quando a decisao resolve divergencia contra um registro
  /// que ja existia na Atendly.
  targetInternalId String?
  /// Observacao sanitizada por codigo estavel.
  noteCode String?

  decidedBy String
  decidedAt DateTime @default(now())
  createdAt DateTime @default(now())

  session ImportSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)
  item    ImportItem?   @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, sessionId, decidedAt])
  @@index([tenantId, sessionId, category, externalId, decidedAt], map: "ImportDecision_tenantId_sessionId_target_idx")
  @@index([tenantId, itemId, decidedAt])
}

model CalendarMutationIdempotency {
  id            String   @id @default(cuid())
  tenantId      String
  key           String
  operation     String
  requestHash   String
  status        String
  response      Json?
  lastErrorCode String?
  /// Referencia ao efeito gravado no mesmo commit da mutacao (Goal008): id
  /// do atendimento, hold ou bloqueio. Um `PENDING` vencido cuja referencia
  /// de efeito ja existe e recuperado como sucesso, nao reexecutado. Nulo
  /// para registros anteriores ao Goal008 e enquanto o passo ainda nao
  /// chegou ao commit do efeito.
  effectEntityType CalendarEffectEntityType?
  effectEntityId   String?
  lockedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, status, updatedAt])
}
