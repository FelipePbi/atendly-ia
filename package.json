{
  "name": "atendly-ia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev:bff": "cd apps/bff && npm run dev",
    "dev:ai-orchestrator": "cd apps/ai-orchestrator && npm run dev",
    "build:frontend": "cd apps/frontend && npm run build",
    "build:bff": "cd apps/bff && npm run build",
    "build:ai-orchestrator": "cd apps/ai-orchestrator && npm run build",
    "build:contracts": "cd packages/contracts && npm run build",
    "build:scheduling-service": "cd apps/scheduling-service && npm run build",
    "build:all": "bash scripts/build-all.sh",
    "check:health-worker": "cd apps/health-worker && npm run check",
    "smoke:final-audit": "node scripts/final-production-audit.mjs",
    "test:evolution-go": "cd apps/evolution-go && go test ./...",
    "test:ai-orchestrator": "cd apps/ai-orchestrator && npm test",
    "test:gate": "node --test scripts/tests/**/*.test.mjs",
    "ia-loop:spike": "node tools/ia-loop/spike-agent-invocation.mjs",
    "ia-loop:supervised": "node tools/ia-loop/run-supervised.mjs",
    "ia-loop:sessions": "node tools/ia-loop/persistent-session-spike.mjs",
    "ia-loop:tech-lead": "node tools/ia-loop/workers/tech-lead.mjs",
    "ia-loop:developer": "node tools/ia-loop/workers/developer.mjs",
    "ia-loop:goal": "node tools/ia-loop/run-goal.mjs",
    "ia-loop:close": "node tools/ia-loop/run-close.mjs",
    "ia-loop:auto": "node tools/ia-loop/run-auto.mjs",
    "ia-loop:pause": "node tools/ia-loop/run-pause.mjs",
    "ia-loop:status": "node tools/ia-loop/run-status.mjs",
    "ia-loop:resources": "node tools/ia-loop/run-resources.mjs",
    "ia-loop:resources:cleanup": "node tools/ia-loop/run-resources-cleanup.mjs",
    "ia-loop:resume": "node tools/ia-loop/run-resume.mjs",
    "ia-loop:recover": "node tools/ia-loop/run-recover.mjs",
    "ia-loop:reclassify": "node tools/ia-loop/run-reclassify.mjs",
    "ia-loop:authorize-retry": "node tools/ia-loop/run-authorize-retry.mjs",
    "ia-loop:reconcile-runtime": "node tools/ia-loop/run-reconcile-runtime.mjs",
    "ia-loop:usage": "node tools/ia-loop/run-usage.mjs",
    "test:ia-loop": "node --test tools/ia-loop/tests/**/*.test.mjs",
    "validate:core": "node scripts/validate-core.mjs",
    "validate:integration": "node scripts/validate-integration.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
